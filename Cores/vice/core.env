# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=ViceCore
CORE_EXPORT=_Vice_GetInterface
CORE_VERSION=3.10

# Source of truth: https://github.com/libretro/vice-libretro, libretro's VICE, built as x64sc (cycle-exact C64).
# GPL-2.0-or-later, with zlib (Zlib), the 7-Zip decoder (public domain) and libretro-common (MIT). Upstream has no
# tags; pinned to the commit below.
UPSTREAM_COMMIT=5ebe7d333ab15be57a9dde5f46c29a5bbd5f44f8

# upstream/Makefile is not run. These match `make EMUTYPE=x64sc platform=ios-arm64` (Makefile, Makefile.common,
# Makefile.x64sc), except that upstream/include/embedded is left off the include path: it holds Commodore's ROMs.
# -Dfdopen=fdopen: bundled zlib's zutil.h defines fdopen away on Apple, which breaks <stdio.h>.
core_defines='-DNDEBUG -DIOS -DHAVE_POSIX_MEMALIGN=1 -DHAVE_7ZIP -D_7ZIP_ST -DHAVE_CONFIG_H -D__LIBRETRO__ -DUSE_LIBRETRO_VFS -DCORE_NAME="x64sc" -D__X64SC__ -DHAVE_STRLCPY -DHAVE_VSNPRINTF -DHAVE_SNPRINTF -DHAVE_STPCPY -D_INTTYPES_H -Dfdopen=fdopen'
v=upstream/vice/src
core_includes="-I. -I../shared -I$v -Iupstream -Iupstream/libretro -Iupstream/include -I$v/core/rtc -I$v/lib -I$v/printerdrv -Iupstream/retrodep -Iupstream/libretro-common/include -Iupstream/deps/libz -I$v/sid -I$v/arch/shared -I$v/c64 -I$v/c64/cart -I$v/core -I$v/datasette -I$v/diag -I$v/drive -I$v/drive/iec -I$v/drive/iec/c64exp -I$v/drive/ieee -I$v/drive/tcbm -I$v/fsdevice -I$v/imagecontents -I$v/joyport -I$v/lib/p64 -I$v/monitor -I$v/raster -I$v/resid -I$v/residfp -I$v/residfp/builders/residfp-builder/residfp -I$v/rs232drv -I$v/rtc -I$v/samplerdrv -I$v/tape -I$v/tapeport -I$v/userport -I$v/vdrive -I$v/viciisc -I$v/video"
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++14 -O2 $core_defines $core_includes -Wno-everything"

# 6510, VIC-II, SID (reSID) and the drives are interpreters. Bare "jit" is not used.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# Offline: config.h undefines HAVE_NETWORK, so RS-232 over TCP, the remote monitor and ethernet carts have no
# sockets. Never loads code, no threads.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_sendto$|_recvfrom$|_dlopen$|_dlsym$|_mprotect$|_pthread_create$'

# Commodore's KERNAL, BASIC, character and drive ROMs (upstream/include/embedded, retrodep/embedded*.c) are never
# compiled; vice_embedded.c stands in and the player's own files load from the system folder.
FORBIDDEN_SOURCES='include/embedded/[^/]*\.h$|retrodep/embedded(/c64embedded)?\.c$'
