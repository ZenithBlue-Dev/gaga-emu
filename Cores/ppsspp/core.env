# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
# PPSSPP, official upstream (hrydgard/ppsspp) at a release tag, with its own libretro frontend.
CORE_FRAMEWORK=PpssppCore
CORE_EXPORT=_Ppsspp_GetInterface
CORE_VERSION=1.20.4
UPSTREAM_TAG=v1.20.4
UPSTREAM_COMMIT=fa50bb1976065c4f8b1b47af227d367fe9771555

# Upstream's own submodules that sources.txt compiles, each at the commit upstream records. FFmpeg is not one:
# upstream ships it as prebuilt binaries, so this build has none (generate.py).
CORE_UPSTREAM_SUBMODULES='libretro/libretro-common ext/armips ext/glslang ext/SPIRV-Cross ext/rapidjson ext/zstd
    ext/cpu_features ext/rcheevos ext/naett ext/libchdr ext/lua ext/freetype ext/nanosvg ext/aemu_postoffice ext/miniupnp'

# sources.txt and cmake.env come from upstream's CMake build: Cores/ppsspp/generate.py writes both.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/cmake.env"

# Links MoltenVK (scripts/build-moltenvk.sh) and the adapter's Vulkan layer path.
CORE_USES_MOLTENVK=1
core_flags="-include flags.h -DGAGA_LIBRETRO_VULKAN -I. -I../shared -I../../build/moltenvk/include $cmake_flags"
core_flags="$core_flags -O2 -fno-strict-aliasing -Wno-everything -Werror=implicit-function-declaration"
CORE_CFLAGS="-std=gnu11 $core_flags"
CORE_CXXFLAGS="-std=gnu++17 $core_flags"
CORE_LDFLAGS='-lz -framework AudioToolbox -framework CoreFoundation'

# Every CPU and vertex JIT is left out of the build; MoltenVK compiles SPIR-V for the GPU only. The binary
# still names the type ARM64XEmitter: the vertex decoder's cache derives from ARM64CodeBlock in upstream's
# headers. No emitter is compiled (FORBIDDEN_SOURCES) and ___clear_cache is never imported (nojit-gate.sh).
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|Arm64Jit|Arm64IRJit|Arm64JitBackend'
FORBIDDEN_SOURCES='Core/MIPS/(ARM|ARM64|x86|RiscV|LoongArch64)/[A-Za-z0-9_]+\.cpp|Common/(Arm|Arm64|x64|RiscV|LoongArch64)Emitter\.cpp|VertexDecoder(Arm|Arm64|X86|RiscV|LoongArch64)\.cpp|upstream/Common/MemoryUtil\.cpp|Common/GPU/OpenGL/[A-Za-z0-9_]+\.cpp|GPU/GLES/'
# Sockets are linked: PSP network modules (sceNet, adhoc) are HLE over BSD sockets. ppsspp_enable_wlan is
# off (PpssppCore.c), so the game sees no network. _dlsym is allowed for compiler-rt's @available check.
FORBIDDEN_IMPORTS='_dlopen$|_mprotect$|_vm_protect$|_sys_icache_invalidate$|_sys_dcache_flush$|_pthread_jit'
