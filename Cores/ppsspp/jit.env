# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh ppsspp sources this after core.env
# and writes build/cores-jit/PpssppCore.xcframework; build/cores is untouched. The DevJIT configuration alone embeds
# it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else. Shell syntax.
#
# Upstream's ARM64 CPU JIT and vertex decoder JIT, on memory from Cores/shared/Jit26.c (iOS 26 TXM: a debugger
# prepares an RX region, the JIT writes through an RW alias). ppsspp_cpu_core becomes "JIT" only when that works.

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/ppsspp"
jit_flags="-iquote $jit_out/shim -include $root/Cores/shared/Jit26.h -DGAGA_CORE_JIT"
jit_flags="$jit_flags -DGAGA_JIT_OPTION_KEY=\"ppsspp_cpu_core\" -DGAGA_JIT_OPTION_VALUE=\"JIT\""
CORE_CFLAGS="$jit_flags $CORE_CFLAGS"
CORE_CXXFLAGS="$jit_flags $CORE_CXXFLAGS"

# Other JIT libraries and back ends stay out; the ARM64 ones are the point of this build.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning'
FORBIDDEN_SOURCES='Core/MIPS/(ARM|x86|RiscV|LoongArch64)/[A-Za-z0-9_]+\.cpp|Common/(Arm|x64|RiscV|LoongArch64)Emitter\.cpp|VertexDecoder(Arm|X86|RiscV|LoongArch64)\.cpp|upstream/Common/MemoryUtil\.cpp|upstream/Common/MemArenaDarwin\.cpp|Common/GPU/OpenGL/[A-Za-z0-9_]+\.cpp|GPU/GLES/'
FORBIDDEN_IMPORTS='_dlopen$|_mprotect$|_pthread_jit'
# Jit26.c: vm_remap and vm_protect make the RW alias, sys_icache_invalidate runs its probe. MemArenaDarwin.cpp's
# vm_remap as in core.env.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
# The JIT sources' code-generation calls are the reviewed purpose of this build.
SOURCE_AUDIT_REVIEWED='^(\.\./shared/Jit26\.c|upstream/Core/MIPS/ARM64/[A-Za-z0-9_]+\.cpp|upstream/Common/Arm64Emitter\.cpp|upstream/GPU/Common/VertexDecoderArm64\.cpp):'
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt and the CodeBlock.h copy. Run from Cores/ppsspp.
core_jit_prepare() {
    local name rest common='' list="$jit_out/sources.txt" shim="$jit_out/shim/Common/CodeBlock.h"
    mkdir -p "$(dirname "$shim")"
    # Upstream's CodeBlock maps one region RWX or flips it; a second mapping is Switch-only. This copy takes the RW alias.
    sed 's/writableRegion = region;/writableRegion = (u8 *)gaga_jit26_writable(region);/' upstream/Common/CodeBlock.h >"$shim"
    [ "$(grep -c 'gaga_jit26_writable' "$shim")" = 1 ] || { echo "jit.env: upstream CodeBlock.h changed; review the copy" >&2; return 1; }
    while read -r name rest; do
        case "$name" in
            JitCommonNoJit.cpp) name=upstream/Core/MIPS/JitCommon/JitCommon.cpp ;;
            MemoryUtil.cpp) name=MemoryUtilJit26.cpp common=$rest ;;
            ../shared/LibretroAdapter.c) name=../shared/LibretroAdapterJit26.c ;;
        esac
        echo "$name${rest:+ $rest}"
    done <sources.txt >"$list"
    { echo ../shared/Jit26.c
      echo "upstream/Common/Arm64Emitter.cpp $common"
      echo upstream/GPU/Common/VertexDecoderArm64.cpp
      for name in upstream/Core/MIPS/ARM64/*.cpp; do echo "$name"; done
    } >>"$list"
}
