# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=GearsystemCore
CORE_EXPORT=_Gearsystem_GetInterface
CORE_VERSION=3.9.24

# Source of truth: https://github.com/drhelius/Gearsystem, the author's repository and the one libretro-super
# builds (platforms/libretro). GPL-3.0-only (LICENSE, file headers). Pinned to release tag 3.9.24.
UPSTREAM_TAG=3.9.24
UPSTREAM_COMMIT=40b8eebab53007c976eb29755b1ef7925140c37f

# upstream/platforms/libretro/Makefile is not run. These match its CFLAGS: no disassembler, no VGM recorder.
core_defines='-DNDEBUG -D__LIBRETRO__ -DGS_DISABLE_DISASSEMBLER -DGS_DISABLE_VGMRECORDER -DMINIZ_NO_TIME'
core_includes='-I../shared -Iupstream/platforms/libretro -Iupstream/src -Iupstream/platforms/shared/dependencies/miniz'
CORE_CFLAGS="-std=gnu11 -O3 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++17 -O3 -fno-exceptions $core_defines $core_includes -Wno-everything"

# A Z80 interpreter with no recompiler. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# Single threaded, offline and never loads code. The link cable is two instances in one process, no socket.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
