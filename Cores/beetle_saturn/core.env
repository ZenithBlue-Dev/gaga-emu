# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=BeetleSaturnCore
CORE_EXPORT=_BeetleSaturn_GetInterface
CORE_VERSION=1.32.1

# Source of truth: https://github.com/libretro/beetle-saturn-libretro, the URL libretro-super builds from (a fork
# of Mednafen's SS module). GPL-2.0-or-later (docs/03 section 5). Upstream tags no releases, so this is the
# master commit of 2026-11-02; MEDNAFEN_CORE_VERSION in libretro.c says v1.32.1.
UPSTREAM_TAG=
UPSTREAM_COMMIT=30f4c12072d265c9e553dcb29386059114945dea

# upstream/Makefile is not run. These match its platform=ios-arm64 build (Makefile.common with NEED_CD,
# NEED_TREMOR, NEED_BPP=32, NEED_DEINTERLACER, NEED_THREADING and HAVE_CHD), with these differences:
# - No WANT_JIT (upstream's WANT_JIT=0), so the SCU DSP and SCSP DSP recompilers are not built, and no file
#   of the JIT is compiled: scsp_dsp_jit*, scu_dsp_jit*, sh7095_jit_x86, a64emit, x86emit and jitdump are left
#   out of sources.txt. With WANT_JIT off on arm64 upstream compiles those files to stubs only; nojit.c holds
#   the same stubs. The SH-2 recompiler exists for x86 hosts only.
# - No -flto. -O2 -DNDEBUG as upstream's release build.
# Threads stay on as upstream ships them for iOS: the VDP2 renderer and the CD reader run on their own threads.
core_defines='-DNDEBUG -D__LIBRETRO__ -D_LOW_ACCURACY_ -DSTDC_HEADERS -D__STDC_LIMIT_MACROS -D__STDC_CONSTANT_MACROS
  -DHAVE_UNISTD_H -DWANT_THREADING -DHAVE_THREADS -DNEED_DEINTERLACER -DWANT_32BPP -DNEED_CD -DNEED_TREMOR
  -DHAVE_CHD -DHAVE_RCHD_DEFLATE -DHAVE_RCHD_LZMA -DHAVE_RCHD_FLAC -DHAVE_RCHD_ZSTD'
core_includes='-I../shared -Iupstream -Iupstream/mednafen -Iupstream/mednafen/include -Iupstream/mednafen/intl
  -Iupstream/mednafen/hw_sound -Iupstream/mednafen/hw_cpu -Iupstream/mednafen/hw_misc -Iupstream/libretro-common/include'
CORE_CFLAGS="-std=gnu11 -O2 -pthread -fno-strict-aliasing $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS=''

# Names only the code generators define: the arm64 and x86 emitters and the jitdump writer. Bare "jit" is not
# used: machine-code bytes can match it, and the core options name it. The JIT entry points share their names
# with the stubs in nojit.c, so FORBIDDEN_SOURCES below is the stronger check.
FORBIDDEN_STRINGS='a64_codegen|encode_logical_imm|x86_codegen|x86_alu_|SS_JitDump|jitdump_'
# The same names in the debug info, which keeps what the binary strips.
FORBIDDEN_DEBUG_STRINGS="$FORBIDDEN_STRINGS"
# No file of the JIT may be compiled. Headers may appear (ss.c reads sh7095_jit.h for declarations).
FORBIDDEN_SOURCES='(_jit|_jit_x86|emit|jitdump)\.c$'

# Offline and never loads code. pthread_create is allowed (see above).
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$|_mmap$'
