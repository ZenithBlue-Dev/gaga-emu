# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=Snes9xCore
CORE_EXPORT=_Snes9x_GetInterface
CORE_VERSION=1.63

# Non-commercial licence (upstream/LICENSE, docs/03 section 5): sideload builds only. scripts/nojit-gate.sh
# and scripts/appstore_release.sh refuse any App Store or TestFlight build that would link this core.
CORE_NONCOMMERCIAL=1

# Upstream's apu/bapu/smp/iplrom.cpp holds Nintendo's 64-byte SPC700 IPL boot ROM, which GagaEmu does not
# ship (docs/03 section 5). Snes9xSmpGaga.cpp compiles smp.cpp with bsnes's clean-room GagaIPL.s in its place,
# and scripts/bootrom-gate.py fails the build if Nintendo's IPL is in the binary.

# Run by scripts/build-core.sh from Cores/snes9x. Writes the copy of smp.cpp that Snes9xSmpGaga.cpp includes,
# without the iplrom.cpp include; the submodule itself is never changed.
core_prepare() {
    local gen=../../build/cores/snes9x/gen
    mkdir -p "$gen"
    sed '/^#include "iplrom.cpp"$/d' upstream/apu/bapu/smp/smp.cpp >"$gen/smp.cpp"
    [ "$(grep -c '^#include "iplrom.cpp"$' upstream/apu/bapu/smp/smp.cpp)" = 1 ] && ! grep -qF iplrom.cpp "$gen/smp.cpp" ||
        { echo "core.env: upstream's smp.cpp IPL include changed; review Snes9xSmpGaga.cpp" >&2; return 1; }
}

# Source of truth: https://github.com/libretro/snes9x, the libretro fork of https://github.com/snes9xgit/snes9x
# and the URL libretro-super builds from. It has no release tags, so this pins the master commit of 2026-09-19.
UPSTREAM_TAG=
UPSTREAM_COMMIT=fae2fea08f74180759ef540ee94259213f503480

# upstream/libretro/Makefile is not run. These are its common defines (__LIBRETRO__, ALLOW_CPU_OVERCLOCK,
# HAVE_STRINGS_H) and the source list of Makefile.common; the IOS and ARM defines it adds select no code.
core_defines='-DNDEBUG -D__LIBRETRO__ -DALLOW_CPU_OVERCLOCK -DHAVE_STRINGS_H'
core_includes='-I../shared -Iupstream/libretro -Iupstream/libretro/libretro-common/include -Iupstream -Iupstream/apu -Iupstream/apu/bapu'
CORE_CFLAGS="-std=gnu11 -O3 -fno-strict-aliasing $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++17 -O3 -fno-strict-aliasing -fno-rtti $core_defines $core_includes -Wno-everything"

# From the source audit in docs/03 section 5: Snes9x has a C++ interpreter only. Bare "jit" is not used:
# machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
