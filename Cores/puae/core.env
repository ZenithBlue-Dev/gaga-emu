# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=PuaeCore
CORE_EXPORT=_Puae_GetInterface
CORE_VERSION=5.3.1

# Source of truth: https://github.com/libretro/libretro-uae, libretro's PUAE (WinUAE-derived). GPL-2.0-or-later,
# with the AROS Kickstart replacement (AROS Public License), zlib, libchdr (BSD-3-Clause), zstd (BSD), libmpeg2
# (GPL-2.0-or-later), the 7-Zip decoder (public domain) and libretro-common (MIT). Upstream has no tags; pinned to
# the commit below.
UPSTREAM_COMMIT=c1d1d49d5c7cdad2005e86f1cbb279d39e041efc

# upstream/Makefile is not run. These match `make platform=ios-arm64` (Makefile, Makefile.common). -I. comes first so
# retrodep/WHDLoad_*.c here stand in for upstream's, which libretro-core.c #includes. -Dfdopen=fdopen: bundled zlib's
# zutil.h defines fdopen away on Apple, which breaks <stdio.h>.
core_defines='-DIOS -DHAVE_POSIX_MEMALIGN=1 -DHAVE_ZLIB -DHAVE_7ZIP -D_7ZIP_ST -DINLINE=inline -D__LIBRETRO__ -DUSE_LIBRETRO_VFS -DWITH_MPEG2 -DWITH_CHD -DZSTD_DISABLE_ASM -DUSE_NAMED_SEMAPHORES -Dfdopen=fdopen'
core_includes='-I. -I../shared -Iupstream/sources/src -Iupstream/sources/src/include -Iupstream -Iupstream/retrodep -Iupstream/deps/7zip -Iupstream/deps/libz -Iupstream/deps/libmpeg2/include -Iupstream/libretro -Iupstream/libretro-common/include -Iupstream/deps/libchdr/include -Iupstream/deps/zstd/lib'
CORE_CFLAGS="-std=gnu99 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="$CORE_CFLAGS"

# The 680x0 is the generated cpuemu interpreter; sysconfig.h leaves JIT undefined and upstream/sources/src/jit is
# not built. Bare "jit" is not used.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec|compemu'

# Never loads code. bsdsocket, uaenet and the serial TCP bridge stay off (no socket calls may appear).
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_sendto$|_recvfrom$|_dlopen$|_dlsym$|_mprotect$'

# Not compiled: WHDLoad's bundled Amiga files (AmigaOS commands and libraries of unclear licence) and the HRTmon
# ROM. retrodep/WHDLoad_*.c and puae_stubs.c stand in.
FORBIDDEN_SOURCES='upstream/retrodep/WHDLoad_(files\.zip|prefs\.gz)\.c$|hrtmon\.rom\.c$'
