# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=HandyCore
CORE_EXPORT=_Handy_GetInterface
CORE_VERSION=0.97

# Source of truth: https://github.com/libretro/libretro-handy, libretro's port of K. Wilkins' Handy. Handy is zlib
# (lynx/license.txt), Blip_Buffer LGPL-2.1-or-later, libretro-common MIT. Chosen over holani (LLeny/holani-retro):
# that one is GPL-3.0 and Rust, which scripts/build-core.sh does not build. Upstream has no tags, so this pins the
# master commit of 2026-04-20.
UPSTREAM_TAG=
UPSTREAM_COMMIT=bc55d462f0b2d6b073ea93dc552ebd73cec60fd1

# upstream/Makefile is not run. These match Makefile.common with the 16-bit and 32-bit pixel paths both on.
core_defines='-DNDEBUG -D__LIBRETRO__ -DFRONTEND_SUPPORTS_RGB565 -DFRONTEND_SUPPORTS_XRGB8888 -DWANT_CRC32'
core_includes='-I../shared -Iupstream/lynx -Iupstream/libretro -Iupstream -Iupstream/libretro-common/include'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++11 -O2 $core_defines $core_includes -Wno-everything"

# A 65C02 interpreter. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# Offline and never loads code.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$|_pthread_create$'
