# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=StellaCore
CORE_EXPORT=_Stella_GetInterface
CORE_VERSION=7.0c

# Source of truth: https://github.com/stella-emu/stella, the Stella team's repository, whose src/os/libretro is
# the libretro target libretro-super builds as "stella". GPL-2.0-or-later. Chosen over stella2014-libretro (a
# 2014 snapshot of Stella 3.9.3 that libretro only keeps building): same licence family, but this one is the
# maintained emulator, with current cartridge schemes and TIA fixes. Pinned to release tag 7.0c.
UPSTREAM_TAG=7.0c
UPSTREAM_COMMIT=c4016ea4891cb0f90979cb35182214af4c1cb4e7

# upstream/src/os/libretro/Makefile is not run. These match its CXXFLAGS. HTTP_LIB_SUPPORT stays undefined, so
# PlusROM carts get no network; no GUI, debugger, image or SQLite support is defined.
core_defines='-DNDEBUG -D__LIB_RETRO__ -DSOUND_SUPPORT -DHAVE_STDINT_H -DARM'
core_includes='-I../shared -Iupstream/src -Iupstream/src/os/libretro -Iupstream/src/emucore -Iupstream/src/emucore/elf -Iupstream/src/emucore/tia -Iupstream/src/common -Iupstream/src/common/audio -Iupstream/src/common/tv_filters -Iupstream/src/common/repository/sqlite -Iupstream/src/lib/json'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=c++20 -O2 -fno-rtti $core_defines $core_includes -Wno-everything"

# A 6502 interpreter, plus the ARM interpreter (Thumbulator, CortexM0) that DPC+, CDF and ELF carts need.
# Neither recompiles. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# Offline and never loads code: no HTTP for PlusROM.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$'
