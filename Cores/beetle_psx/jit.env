# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh beetle_psx sources this after
# core.env and writes build/cores-jit/BeetlePsxCore.xcframework; build/cores is untouched. The DevJIT configuration
# alone embeds it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else. Shell syntax.
#
# Upstream's lightrec recompiler on GNU Lightning (HAVE_LIGHTREC, the files and defines of upstream's Makefile with
# THREADED_RECOMPILER=0), on memory from Cores/shared/Jit26.c. Lightning writes and patches code in one mapping;
# iOS 26 (TXM) gives no writable executable page, so three build-time copies of Lightning emit at the RX address
# and store through the RW alias (gaga_lightning_rw_delta): lightning.c (no mmap/mprotect: HAVE_MMAP 0, lightrec
# always hands it the code buffer), jit_aarch64.c (jit_flush invalidates the RX range with sys_icache_invalidate)
# and jit_aarch64-cpu.c (ii() and patch_at write through the alias). lightrec's code buffer is one Jit26 region;
# its TLSF allocator keeps its headers inside the pool, so BeetlePsxJit26.c runs TLSF on the RW alias and hands
# lightrec RX addresses. Lightning already keeps x18 out of its register file on Apple (jit_aarch64.c, checked below).
# libretro.c's own RWX code-buffer mapping is compiled out (ENABLE_CODE_BUFFER 0 there); cpu.c takes the Jit26
# buffer instead. beetle_psx_hw_cpu_dynarec becomes "execute" only when that buffer exists (gaga_beetle_jit_ready).

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/beetle_psx"
jit_flags='-DGAGA_CORE_JIT -DGAGA_JIT_OPTION_KEY="beetle_psx_hw_cpu_dynarec" -DGAGA_JIT_OPTION_VALUE="execute"'
jit_flags="$jit_flags -DHAVE_LIGHTREC -DLOG_LEVEL=3 -DENABLE_DISASSEMBLER=0 -DHAS_DEFAULT_ELM=1 -DENABLE_THREADED_COMPILER=0"
jit_flags="$jit_flags -DLIGHTREC_CODEBUFFER_SIZE=0x800000"
jit_flags="$jit_flags -Iupstream/deps/lightning/include -Iupstream/deps/lightrec -Iupstream/include -include upstream/include/debug.h"
CORE_CFLAGS="$jit_flags $CORE_CFLAGS"
CORE_CXXFLAGS="$jit_flags $CORE_CXXFLAGS"

# lightrec and Lightning are the point of this build; the OpenGL renderer and memmap.c stay out as in core.env.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::'
FORBIDDEN_SOURCES='rhi_lib_gl\.c|glsym/|memmap/memmap\.c|lightning/lib/jit_(x86|arm|mips|ppc|sparc|ia64|hppa|s390|alpha|riscv|loongarch|sh)[.-]'
# core.env's list without the two calls Jit26 needs (vm_protect, sys_icache_invalidate), which ALLOWED_IMPORTS reviews.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_mprotect$|_sys_dcache_flush$|_pthread_jit'
# Jit26.c: vm_remap and vm_protect make the RW alias; sys_icache_invalidate runs its probe and Lightning's jit_flush.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
# Lightning's code-generation calls are the reviewed purpose of this build; core.env's review of libretro.c holds.
SOURCE_AUDIT_REVIEWED="$SOURCE_AUDIT_REVIEWED|^(\.\./shared/Jit26\.c|$jit_out/lightning/(lightning|jit_aarch64)\.c):"
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt and the Lightning copies. Run from Cores/beetle_psx.
core_jit_prepare() {
    local name rest list="$jit_out/sources.txt" ln=upstream/deps/lightning lr=upstream/deps/lightrec cp="$jit_out/lightning"
    mkdir -p "$cp"
    # x18 is Apple's platform register: upstream's Apple branch leaves it out of the allocatable set.
    [ "$(grep -cE '^[[:space:]]*\{ 0x12,[[:space:]]*"x18" \},$' "$ln/lib/jit_aarch64.c")" = 1 ] || { echo "jit.env: Lightning's x18 entry changed; review" >&2; return 1; }
    awk '{ print } /^#include <lightning\/jit_private.h>$/ { print "#undef HAVE_MMAP"; print "#define HAVE_MMAP 0 /* jit.env: lightrec hands Lightning every code and data buffer */" }' \
        "$ln/lib/lightning.c" >"$cp/lightning.c"
    { echo '#include <libkern/OSCacheControl.h>'
      echo 'extern long gaga_lightning_rw_delta; /* jit.env: RW alias minus RX address of the code buffer */'
      sed 's|^\([[:space:]]*\)__clear_cache((void \*)f, (void \*)t);$|\1sys_icache_invalidate((void *)f, t - f); /* jit.env: the RX range */|' "$ln/lib/jit_aarch64.c"
    } >"$cp/jit_aarch64.c"
    sed -e 's|^\(#  define ii(i)[[:space:]]*\)\*_jit->pc\.ui++ = i$|\1(*(jit_uint32_t *)((jit_uint8_t *)_jit->pc.ui++ + gaga_lightning_rw_delta) = (i))|' \
        -e 's|u\.i\[\([0-3]\)\] = i\.w;|*(jit_int32_t *)((jit_uint8_t *)(u.i + \1) + gaga_lightning_rw_delta) = i.w;|' \
        "$ln/lib/jit_aarch64-cpu.c" >"$cp/jit_aarch64-cpu.c"
    [ "$(grep -c '^#define HAVE_MMAP 0 ' "$cp/lightning.c")" = 1 ] &&
        [ "$(grep -c 'sys_icache_invalidate((void \*)f, t - f);' "$cp/jit_aarch64.c")" = 1 ] &&
        [ "$(grep -c 'gaga_lightning_rw_delta) = (i))$' "$cp/jit_aarch64-cpu.c")" = 1 ] &&
        [ "$(grep -c 'gaga_lightning_rw_delta) = i\.w;$' "$cp/jit_aarch64-cpu.c")" = 6 ] &&
        ! grep -q '\*_jit->pc\.' "$cp/jit_aarch64-cpu.c" "$cp/jit_aarch64.c" ||
        { echo "jit.env: upstream Lightning changed; review the copies" >&2; return 1; }
    # libretro.c maps its own RWX code buffer when lightrec-config.h enables one; this keeps it to RAM, BIOS, scratchpad.
    # Its plain-mmap branch (no HAVE_SHM: no shm_open in the iOS sandbox) passes a memfd it never declares or reads.
    printf '#include <lightrec-config.h>\n#undef ENABLE_CODE_BUFFER\n#define ENABLE_CODE_BUFFER 0 /* jit.env */\nstatic const int memfd = -1;\n' >"$jit_out/no_code_buffer.h"
    while read -r name rest; do
        case "$name" in
            ../shared/LibretroAdapter.c) name=../shared/LibretroAdapterJit26.c rest="-Dgaga_jit26_wanted=gaga_beetle_jit_ready${rest:+ $rest}" ;;
            upstream/mednafen/psx/cpu.c) rest="-Dlightrec_codebuffer=gaga_beetle_codebuffer${rest:+ $rest}" ;;
            upstream/libretro.c) rest="-include $jit_out/no_code_buffer.h${rest:+ $rest}" ;;
        esac
        echo "$name${rest:+ $rest}"
    done <sources.txt >"$list"
    [ "$(grep -cE 'gaga_beetle_jit_ready|gaga_beetle_codebuffer|no_code_buffer' "$list")" = 3 ] || { echo "jit.env: sources.txt changed; review the list" >&2; return 1; }
    { echo ../shared/Jit26.c
      echo BeetlePsxJit26.c
      # The copy's other quoted includes resolve against upstream's folder.
      echo "$cp/lightning.c -iquote $ln/lib"
      for name in jit_disasm jit_memory jit_names jit_note jit_print jit_size; do echo "$ln/lib/$name.c"; done
      for name in blockcache constprop emitter interpreter memmanager optimizer reaper regcache; do echo "$lr/$name.c"; done
      echo "$lr/lightrec.c -Dtlsf_create_with_pool=gaga_tlsf_create_with_pool -Dtlsf_malloc=gaga_tlsf_malloc -Dtlsf_realloc=gaga_tlsf_realloc -Dtlsf_free=gaga_tlsf_free"
      echo "$lr/tlsf/tlsf.c"
    } >>"$list"
}
