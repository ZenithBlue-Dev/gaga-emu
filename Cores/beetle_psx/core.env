# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=BeetlePsxCore
CORE_EXPORT=_BeetlePsx_GetInterface
CORE_VERSION=0.9.44.1

# Source of truth: https://github.com/libretro/beetle-psx-libretro, the URL libretro-super builds from.
# GPL-2.0 (upstream/COPYING). No release tags, so this pins the master commit of 2026-11-01.
UPSTREAM_TAG=
UPSTREAM_COMMIT=71ee81e77acd49296ecf4a683f5a61568ba80bf9

# upstream/Makefile is not run. sources.txt is its list for make -n platform=ios-arm64 HAVE_VULKAN=1
# HAVE_OPENGL=0 HAVE_LIGHTREC=0 (the HW build, HAVE_HW, with Vulkan only), with these differences (milestone
# 5.4, docs/07):
# - No HAVE_LIGHTREC: no lightrec or GNU Lightning file, and the R3000A is Mednafen's interpreter. Every
#   lightrec path in libretro.c sits under #ifdef HAVE_LIGHTREC.
# - No HAVE_OPENGL: rhi_lib_gl.c and glsym are not compiled (docs/05 rule 4). Vulkan is the only hardware
#   renderer; the software rasterizer is always compiled.
# - libretro-common's memmap/memmap.c is not compiled (RWX and MAP_JIT allocators). beetle_memmap.c stands in
#   for the six page-reservation calls data_transfer.c makes.
# - GIT_VERSION comes from flags.h, since a define with a space cannot pass through this file.
# The defines below are the Makefile's for that build.
core_defines='-DNDEBUG -DIOS=1 -DHAVE_UNISTD_H -DGPU_HAVE_NEON=1 -DHAVE_HW -DHAVE_VULKAN -DHAVE_PBP
  -DWANT_THREADING -DHAVE_THREADS -DNEED_DEINTERLACER -DWANT_32BPP -DNEED_CD -DHAVE_CHD -DHAVE_RCHD
  -DHAVE_RCHD_DEFLATE -DHAVE_RCHD_LZMA -DHAVE_RCHD_FLAC -DHAVE_RCHD_ZSTD -DHAVE_RFLAC -DHAVE_RZSTD
  -DTEXTURE_DUMPING_ENABLED -DHAVE_RPNG -DHAVE_RJPEG -DHAVE_RBMP -DHAVE_RTGA -DHAVE_RWEBP -DHAVE_RDDS
  -DMEDNAFEN_VERSION_NUMERIC=9386 -DSTDC_HEADERS -D__STDC_LIMIT_MACROS -D__LIBRETRO__ -D_LOW_ACCURACY_
  -D_FILE_OFFSET_BITS=64 -D__STDC_CONSTANT_MACROS -DGAGA_LIBRETRO_VULKAN'
up=upstream
# upstream's own Vulkan headers (header version 95): rhi_lib_vulkan.c uses the *_RANGE_SIZE enums that newer
# headers dropped. sources.txt gives LibretroVulkan.c MoltenVK's headers instead, for VK_EXT_metal_surface.
core_includes="-I. -I../shared -I$up -I$up/mednafen -I$up/mednafen/include
  -I$up/libretro-common/include -I$up/parallel-psx/khronos/include -I$up/parallel-psx/SPIRV-Cross"
CORE_CFLAGS="-std=gnu17 -O3 -fsigned-char -fwrapv -include flags.h $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=c++11 -O3 -fsigned-char -fwrapv -fno-exceptions -DSPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS -DHAVE_LIBRETRO -include flags.h $core_defines $core_includes -Wno-everything"

# MoltenVK and the adapter's layer path (docs/05 section 2.3).
CORE_USES_MOLTENVK=1

# Reviewed hits of the source audit: libretro.c's MAP_CODE macros (2738, 2751) map lightrec's code buffer and
# sit inside #ifdef HAVE_LIGHTREC, which this build never defines.
SOURCE_AUDIT_REVIEWED='^upstream/libretro\.c:(2738|2751):'

# Checked against the dSYM: no lightrec or GNU Lightning file, no OpenGL renderer or GL loader, and not
# libretro-common's memmap.c.
FORBIDDEN_SOURCES='(lightrec|lightning)/[^ ]*\.c$|rhi_lib_gl\.c|glsym/|memmap/memmap\.c'
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|lightrec_init|lightrec_execute'

# _dlsym is allowed for compiler-rt's @available checks and rthreads' pthread_setname_np lookup, as for the
# other layer-path cores. dlopen is not: flags.h replaces it.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_mprotect$|_vm_protect$|_sys_icache_invalidate$|_sys_dcache_flush$|_pthread_jit_write_protect_np$'
