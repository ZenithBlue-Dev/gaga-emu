# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=GenesisPlusGXCore
CORE_EXPORT=_GenesisPlusGX_GetInterface
CORE_VERSION=1.7.4

# Non-commercial licence (upstream/LICENSE.txt, docs/03 section 5): sideload builds only. scripts/nojit-gate.sh
# and scripts/appstore_release.sh refuse any App Store or TestFlight build that would link this core.
CORE_NONCOMMERCIAL=1

# Source of truth: https://github.com/libretro/Genesis-Plus-GX, the libretro repository of Eke-Eke's emulator
# and the URL libretro-super builds from. It has no release tags, so this pins the master commit of 2026-10-30.
UPSTREAM_TAG=
UPSTREAM_COMMIT=f27655b592ef43f317272d79883bcaa10d3ac8ad

# upstream/Makefile.libretro is not run. These are its iOS defines (HAVE_CHD on, HAVE_CDROM off, RGB565, Tremor
# for Ogg CD audio, per-channel volumes), with its source list from libretro/Makefile.common.
core_defines='-DNDEBUG -D__LIBRETRO__ -DUSE_LIBRETRO_VFS -DLSB_FIRST -DBYTE_ORDER=LITTLE_ENDIAN -DHAVE_ZLIB -DUSE_LIBTREMOR -DUSE_LIBCHDR -DUSE_PER_SOUND_CHANNELS_CONFIG -DUSE_16BPP_RENDERING -DFRONTEND_SUPPORTS_RGB565 -DM68K_OVERCLOCK_SHIFT=20 -DZ80_OVERCLOCK_SHIFT=20 -DHAVE_YM3438_CORE -DHAVE_OPLL_CORE -DMAXROMSIZE=33554432 -D_7ZIP_ST -DZSTD_DISABLE_ASM'
core_includes='-I../shared'
for gpgx_dir in core core/z80 core/m68k core/ntsc core/sound core/sound/minimp3 core/input_hw core/cd_hw core/cart_hw core/cart_hw/svp; do
    core_includes="$core_includes -Iupstream/$gpgx_dir"
done
core_includes="$core_includes -Iupstream/libretro -Iupstream/libretro/libretro-common/include -Iupstream/libretro/deps/libchdr/include -Iupstream/libretro/deps/lzma-19.00/include -Iupstream/libretro/deps/zlib-1.2.11 -Iupstream/libretro/deps/zstd/lib"
CORE_CFLAGS="-std=gnu11 -O3 -fno-strict-aliasing $core_defines -include flags.h $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++17 -O3 $core_defines $core_includes -Wno-everything"

# From the source audit in docs/03 section 5: the 68000, Z80 and SSP1601 (SVP) are interpreters, and the tree
# has no recompiler. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
