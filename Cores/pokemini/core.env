# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=PokeMiniCore
CORE_EXPORT=_PokeMini_GetInterface
CORE_VERSION=0.60

# Source of truth: https://github.com/libretro/PokeMini, the URL libretro-super builds from.
# GPL-3.0-or-later (LICENSE; the source files say "version 3 or later"). No release tags, so this pins the
# master commit of 2026-07-31. An S1C88 interpreter with its own free BIOS built in; no recompiler exists.
UPSTREAM_TAG=
UPSTREAM_COMMIT=132111b76343559860532a1ccc094f93f1ed5650

# upstream/Makefile.libretro is not run. These match what it and Makefile.common define for ios-arm64 (printed
# with make, not built).
# GIT_VERSION is left out: no source reads it.
core_defines='-DNDEBUG -D__LIBRETRO__ -DIOS'
core_includes='-I../shared -Iupstream/libretro -Iupstream/libretro/libretro-common/include -Iupstream/source
  -Iupstream/resource -Iupstream/freebios'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS=''

# From the source audit in docs/03 section 5. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
