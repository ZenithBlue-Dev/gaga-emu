# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=BsnesCore
CORE_EXPORT=_Bsnes_GetInterface
CORE_VERSION=115
# Upstream's resources.hpp holds Nintendo's 64-byte SPC700 IPL boot ROM, which GagaEmu does not ship
# (docs/03 section 5). BsnesProgramGaga.cpp swaps in GagaIPL.s, a clean-room boot program, and
# scripts/bootrom-gate.py fails the build if Nintendo's IPL is in the binary.

# Source of truth: https://github.com/libretro/bsnes-libretro, the libretro fork of
# https://github.com/bsnes-emu/bsnes and the URL libretro-super's iOS recipe builds from. GPL-3.0-or-later.
# Its "nightly" tag moves, so this pins the master commit of 2026-11-06.
UPSTREAM_TAG=
UPSTREAM_COMMIT=b51612a74c4ff4b91aa55eb094940d9d848e0e96

# Neither upstream makefile is run. These match what libretro-super's iOS recipe gets from
# bsnes/GNUmakefile (target=libretro, build=performance, openmp=false), with GB_VERSION from gb/version.mk.
# libco.c here replaces upstream/libco, and BsnesSupport.cpp replaces upstream/bsnes/filter/filter.cpp,
# and BsnesProgramGaga.cpp wraps upstream/bsnes/target-libretro/program.cpp.
core_defines='-DNDEBUG -DBUILD_PERFORMANCE -DHAVE_POSIX_MEMALIGN -DGB_INTERNAL -DGB_DISABLE_DEBUGGER -DGB_DISABLE_CHEATS -D_GNU_SOURCE -DGB_VERSION="1.0.2"'
core_includes='-I../shared -Iupstream -Iupstream/bsnes -Iupstream/bsnes/target-libretro'
core_common='-O3 -fno-strict-aliasing -fwrapv -Wno-everything'
CORE_CFLAGS="-std=c11 $core_common $core_defines $core_includes -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=c++17 $core_common $core_defines $core_includes"

# From the source audit in docs/03 section 5. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. Upstream libco makes its switch routine
# executable with mprotect; libco.c here does not, so an mprotect import means upstream's came back.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
