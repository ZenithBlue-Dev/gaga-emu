# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=MgbaCore
CORE_EXPORT=_Mgba_GetInterface
CORE_VERSION=0.10.5

# Source of truth: https://github.com/mgba-emu/mgba, linked from https://mgba.io. MPL-2.0.
UPSTREAM_TAG=0.10.5
UPSTREAM_COMMIT=26b7884bc25a5933960f3cdcd98bac1ae14d42e2

# upstream/CMakeLists.txt is not run. These match what its libretro target sets, minus COLOR_16_BIT:
# the bridge takes 32-bit frames, so the renderer does no conversion at the end of each line.
CORE_CFLAGS='-std=gnu11 -O3 -DNDEBUG -D_DARWIN_C_SOURCE -include flags.h -Iupstream/include -Iupstream/src -Iupstream/src/third-party/inih -Wno-everything -Werror=implicit-function-declaration'
CORE_CXXFLAGS=''

# From the source audit in docs/03 section 5. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
