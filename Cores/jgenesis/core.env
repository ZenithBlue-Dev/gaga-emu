# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=JgenesisCore
CORE_EXPORT=_Jgenesis_GetInterface
CORE_VERSION=0.14.1

# Source of truth: https://github.com/jsgroth/jgenesis, the author's own repository, linked from its
# README and release pages. GPL-3.0. iOS is not an official target: this is GagaEmu's own port.
UPSTREAM_TAG=v0.14.1
UPSTREAM_COMMIT=cbe7f129e3f5c805a2a2e4318981834192116e90

# Upstream's own build is not run. shim/ is a crate of ours over upstream's emulation crates only
# (genesis-core, segacd-core and what they need); cargo builds it with --locked from shim/Cargo.lock into
# a static library that links with JgenesisCore.c. The frontends, wgpu, SDL and egui are never compiled.
CORE_CARGO_MANIFEST=shim/Cargo.toml
CORE_CARGO_LIB=libjgenesis_gaga.a
CORE_CFLAGS='-std=c11 -O2 -Wall -Werror'
CORE_CXXFLAGS=''

# From the audit in docs/03 section 5: the lock has no cranelift, dynasm or wasmtime crate. Bare "jit" is
# not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='cranelift|dynasmrt|wasmtime|asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a crate or
# a std feature that needs them was pulled in.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
