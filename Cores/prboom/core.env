# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=PrboomCore
CORE_EXPORT=_Prboom_GetInterface
CORE_VERSION=2.5.0

# Source of truth: https://github.com/libretro/libretro-prboom, libretro's PrBoom (Doom, Heretic, Hexen). GPL-2.0-or-later,
# with prboom.wad (PrBoom's own engine lumps, GPL, compiled in as src/prboom_wad_data.h), Nuked-SC55 (GPL-2.0-or-later),
# DOSBox OPL (GPL-2.0-or-later) and libretro-common (MIT). Upstream has no tags; pinned to the commit below.
UPSTREAM_COMMIT=4849268e7342494193f2bbf2d0128a751cf58da7

# upstream/Makefile is not run. These match `make platform=ios-arm64` (Makefile, Makefile.common) without HAVE_THREADS:
# the threaded renderer and the SC-55 worker then run inline, so the core starts no thread.
core_defines='-DNDEBUG -DHAVE_MMAP -DHAVE_RVORBIS -DHAVE_RMP3 -DHAVE_RMODTRACKER -DHAVE_RWAV -DHAVE_RPNG -DHAVE_RJPEG -DINLINE=inline'
core_includes='-I../shared -Iupstream -Iupstream/src -Iupstream/libretro -Iupstream/libretro/libretro-common/include'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="$CORE_CFLAGS"

# A software renderer; there is no CPU to recompile.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# Offline, single-threaded and never loads code.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_sendto$|_recvfrom$|_dlopen$|_dlsym$|_mprotect$|_pthread_create$'

# Not compiled: libretro-common's memmap.c, which can map executable memory. prboom_memmap.c stands in.
FORBIDDEN_SOURCES='memmap/memmap\.c$'
