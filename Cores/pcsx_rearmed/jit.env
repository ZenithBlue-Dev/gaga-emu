# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh pcsx_rearmed sources this after
# core.env and writes build/cores-jit/PcsxReArmedCore.xcframework; build/cores is untouched. The DevJIT configuration
# alone embeds it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else. Shell syntax.
#
# Upstream's ARM64 dynarec (ari64: libpcsxcore/new_dynarec, as its Makefile builds DYNAREC=ari64), on memory from
# Cores/shared/Jit26.c. new_dynarec.c is compiled with HAVE_LIBNX so it takes its Switch path: an RX translation cache
# plus an RW alias (TC_WRITE_OFFSET); jit/switch.h serves that API from Jit26. pcsx_rearmed_drc becomes "enabled",
# and PcsxJit26.c lets retro_init start the dynarec, only when that memory runs. No NDRC_THREAD, no lightrec. The
# register allocator leaves x18 alone (core_jit_prepare's assem_arm64.h copy).

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/pcsx_rearmed"
jit_flags="-DGAGA_CORE_JIT -DGAGA_JIT_OPTION_KEY=\"pcsx_rearmed_drc\" -DGAGA_JIT_OPTION_VALUE=\"enabled\""
CORE_CFLAGS="$jit_flags ${CORE_CFLAGS/-DDRC_DISABLE/}"

# lightrec and GNU Lightning stay out, as do the ARM32 dynarec's files.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|lightrec_'
FORBIDDEN_SOURCES='(lightrec|lightning)/[^ ]*\.(c|cpp|S)$|(linkage_arm|assem_arm)\.'
FORBIDDEN_IMPORTS="$FORBIDDEN_IMPORTS|_pthread_jit"
# Jit26.c: vm_remap and vm_protect make the RW alias; sys_icache_invalidate runs its probe and jit/switch.h's flush.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
# The dynarec's code-generation calls are the reviewed purpose of this build.
SOURCE_AUDIT_REVIEWED="^(\.\./shared/Jit26\.c|upstream/libpcsxcore/new_dynarec/[a-z0-9_]+\.(c|S)|$jit_out/ndrc/new_dynarec\.c):"
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt. Run from Cores/pcsx_rearmed.
core_jit_prepare() {
    local name rest dyn=upstream/libpcsxcore/new_dynarec list="$jit_out/sources.txt" ndrc="$jit_out/ndrc"
    mkdir -p "$ndrc"
    # Upstream may allocate x18 (assem_arm64.h: EXCLUDE_REG -1), the platform register Apple reserves and the kernel
    # may clear. new_dynarec.c is compiled from an unchanged copy, so its quoted include finds this header copy first.
    cp "$dyn/new_dynarec.c" "$ndrc/new_dynarec.c"
    sed 's/^#define EXCLUDE_REG -1$/#define EXCLUDE_REG 18 \/\/ x18: Apple platform register (jit.env)/' "$dyn/assem_arm64.h" >"$ndrc/assem_arm64.h"
    [ "$(grep -c '^#define EXCLUDE_REG 18 ' "$ndrc/assem_arm64.h")" = 1 ] || { echo "jit.env: upstream assem_arm64.h changed; review the copy" >&2; return 1; }
    while read -r name rest; do
        case "$name" in
            nodrc.c) name=$dyn/emu_if.c ;;
            ../shared/LibretroAdapter.c) name=../shared/LibretroAdapterJit26.c ;;
            upstream/frontend/libretro.c) rest="-Demu_core_preinit=gaga_pcsx_jit_preinit${rest:+ $rest}" ;;
        esac
        echo "$name${rest:+ $rest}"
    done <sources.txt >"$list"
    { echo ../shared/Jit26.c
      echo PcsxJit26.c
      # Its other quoted includes, ../ paths too, resolve against upstream's folder.
      echo "$ndrc/new_dynarec.c -DHAVE_LIBNX -Ijit -iquote $dyn"
      echo "$dyn/pcsxmem.c"
      echo "$dyn/linkage_arm64.S"
      # The dynarec calls these GTE routines; upstream's Makefile adds them for every arm64 build.
      echo upstream/libpcsxcore/gte_arm64.S
      echo upstream/libpcsxcore/gte_nf_arm64.S
    } >>"$list"
}
