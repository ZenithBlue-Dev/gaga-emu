# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=PcsxReArmedCore
CORE_EXPORT=_PcsxReArmed_GetInterface
CORE_VERSION=r26

# Source of truth: https://github.com/libretro/pcsx_rearmed, the URL libretro-super builds from (a fork of
# notaz/pcsx_rearmed). GPL-2.0. Pinned to the master commit of 2026-10-29, 137 commits after tag r26l.
UPSTREAM_TAG=
UPSTREAM_COMMIT=7b0e8f8fadfbce3d170d195b9d9eecaabfa08c8e

# upstream/Makefile.libretro is not run. These match its platform=ios-arm64 build (DYNAREC=0, BUILTIN_GPU=neon,
# arm64, so the C SIMD path of gpu_neon and no assembly), with these differences:
# - DRC_DISABLE, and no file from libpcsxcore/new_dynarec, libpcsxcore/lightrec, deps/lightrec or
#   deps/lightning is compiled. nodrc.c stands in for the stubs upstream keeps in new_dynarec/emu_if.c.
# - No USE_ASYNC_CDROM, USE_ASYNC_GPU or USE_ASYNC_SPU, so no thread is started. USE_LIBRETRO_VFS and
#   HAVE_PHYSICAL_CDROM are off: files are read with stdio, and libretro-common is not compiled.
# - NO_DYLIB: no external plugin loading.
# - TVOS: its only effect in the compiled files is to skip a ptrace(PT_TRACE_ME) call in retro_init, which
#   upstream says is there to make the dynarec work on iOS.
# - No Z7_LZMA_DEC_OPT, so lzma's arm64 assembly is not compiled.
# Per-file defines in upstream's Makefile (NEON_BUILD and the texture caches for gpu_neon, SIMD_BUILD) are set
# for every file: only gpu_neon reads them. revision.h, which upstream generates with git, is ours.
core_defines='-DNDEBUG -D_DARWIN_C_SOURCE -DHAVE_LIBRETRO -DNO_FRONTEND -DNO_DYLIB -DTVOS -DDRC_DISABLE
  -DP_HAVE_MMAP=1 -DP_HAVE_POSIX_MEMALIGN=1 -DDISABLE_MEM_LUTS=0
  -DGPU_NEON -DBUILTIN_GPU=neon -DNEON_BUILD -DSIMD_BUILD -DTEXTURE_CACHE_4BPP -DTEXTURE_CACHE_8BPP
  -DHAVE_CHD -DUSE_MINIZ -DMINIZ_NO_STDIO -DMINIZ_NO_DEFLATE_APIS -DMINIZ_NO_ARCHIVE_APIS'
core_includes='-I. -I../shared -Iupstream/include -Iupstream/deps/libretro-common/include
  -Iupstream/deps/libchdr/include -Iupstream/deps/libchdr/deps/lzma-26.02/include
  -Iupstream/deps/libchdr/deps/zstd-1.5.7 -Iupstream/deps/libchdr/deps/miniz-3.1.2'
CORE_CFLAGS="-std=gnu11 -O3 -ffast-math $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS=''

# From the source audit in docs/03 section 5. Bare "jit" is not used: machine-code bytes can match it.
# Bare "dynarec" and "lightrec" are not used either: the core options' help text names both. "ari64" is what
# misc.c's build string says when the ARM dynarec is configured. FORBIDDEN_SOURCES below is the stronger check.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|lightrec_|new_dynarec|ari64'

# Checked against the dSYM by scripts/build-core.sh: proof that no file of a dynarec was compiled. Headers may
# appear (nodrc.c reads new_dynarec.h for a struct), so only .c, .cpp and .S files count.
FORBIDDEN_SOURCES='(new_dynarec|lightrec|lightning)/[^ ]*\.(c|cpp|S)$|(linkage_arm|assem_arm)'

# This build is single threaded, offline and never loads code. ptrace and syscall are what the skipped
# retro_init call would import. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_ptrace$|_syscall$|_mprotect$'
