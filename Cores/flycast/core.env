# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=FlycastCore
CORE_EXPORT=_Flycast_GetInterface
CORE_VERSION=2.7

# Source of truth: https://github.com/flyinghead/flycast, which builds its own libretro core
# (shell/libretro). GPL-2.0 or later. Release tag v2.7.
UPSTREAM_TAG=v2.7
UPSTREAM_COMMIT=5aa091fde632fb332c8d8c34e280d62dc951954c

# upstream's CMake is not run. sources.txt is its LIBRETRO=ON, USE_VULKAN=ON, USE_OPENGL=OFF iOS target
# with these differences (milestone 6.2, docs/07):
# - TARGET_NO_REC, upstream's own switch for its iOS Simulator build: FEAT_SHREC, FEAT_AREC and FEAT_DSPREC
#   are DYNAREC_NONE, so the SH-4, ARM7 and AICA DSP run their interpreters. No recompiler file is listed:
#   core/rec-*, core/hw/sh4/dyna, core/hw/arm7/arm7_rec*, core/hw/aica/dsp_{arm32,arm64,x64,x86} and vixl.
# - No core/linux/posix_vmem.cpp, which maps memory and protects pages, and no core/linux/common.cpp,
#   which installs the SIGSEGV handler those protections need. FlycastSupport.cpp stands in for both.
# - No GL, GLES or IOS defines: Vulkan is the only renderer, through MoltenVK on the layer path.
# - No resource library (CMakeRC), tinygettext, libzip, 7-Zip or zip/7z content, and no Adreno driver
#   loader: FlycastSupport.cpp says what replaces each.
# - AddrspaceHeap.cpp stands in for core/hw/mem/addrspace.cpp: the same file, but initMappings keeps the
#   heap blocks it has instead of freeing and allocating them again under the SH-4's pointers. No xxhash.c: XXH_INLINE_ALL makes Flycast's
#   xxHash and zstd's copy header-only, so the two never clash.
# - zstd: decompression only, single-threaded. zlib without the gz* files.
# - Pinned dependencies upstream takes from submodules are submodules of this repository under deps/,
#   each at the commit upstream v2.7 records: glslang, VulkanMemoryAllocator, Vulkan-Headers, libchdr
#   (with its zlib, zstd and LZMA) and asio. include/glslang/build_info.h is what glslang's CMake writes,
#   and include/version.h what upstream's CMake writes from core/version.h.in.
core_defines='-DNDEBUG -DLIBRETRO -DTARGET_IPHONE -DTARGET_NO_REC -DUSE_VULKAN -DHAVE_VULKAN
  -DVK_ENABLE_BETA_EXTENSIONS -DVK_USE_PLATFORM_METAL_EXT -D_7ZIP_ST -DZ7_ST -DFEAT_NO_MINIUPNPC -DNOWIDE_NO_LIB
  -DXXH_INLINE_ALL -DENABLE_OPT=0 -DENABLE_SPIRV -DGLSLANG_OSINCLUDE_UNIX -DZSTD_DISABLE_ASM
  -DZSTD_LEGACY_SUPPORT=0 -DGAGA_LIBRETRO_VULKAN'
up=upstream/core
common_includes="-I. -I../shared -Iinclude -I$up -I$up/deps -I$up/deps/stb -I$up/deps/json -Ideps/asio/asio/include
  -Iupstream/shell/libretro -Ideps/libchdr/include -I$up/deps/picotcp/include -I$up/deps/picotcp/modules
  -I$up/deps/libretro-common/include -I$up/deps/xxHash -I$up/deps/glm -Ideps -Ideps/glslang -Ideps/libchdr/deps/zlib-1.3.1
  -Ideps/libchdr/deps/zstd-1.5.6/lib -Ideps/libchdr/deps/lzma-24.05/include -I$up/deps/nowide/include
  -I$up/deps/libelf/include -Ideps/VulkanMemoryAllocator/include"
# Flycast's C++ is written against the Vulkan-Headers it pins. The C files that call MoltenVK directly
# (LibretroVulkan.c) use MoltenVK's own headers.
CORE_CFLAGS="-std=gnu11 -O3 -fno-strict-aliasing -include flags.h $core_defines -I../../build/moltenvk/include $common_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++17 -O3 -fno-strict-aliasing -include flags.h $core_defines -DVK_NO_PROTOTYPES -Ideps/Vulkan-Headers/include $common_includes -Wno-everything"
CORE_LDFLAGS='-framework AudioToolbox -framework CoreFoundation'

# MoltenVK and the adapter's layer path (docs/05 section 2.3).
CORE_USES_MOLTENVK=1

# From the source audit in docs/03 section 5. Bare "jit" and "dynarec" are not used: Flycast's option and
# log text names them. FORBIDDEN_SOURCES below is the stronger check.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|ngen_Compile|rec_arm64|arm7_rec|dsp_arm64|prepare_jit_block failed'

# Checked against the dSYM: no recompiler, no virtual memory or fault handler file, no GL renderer.
FORBIDDEN_SOURCES='core/(rec-[^/]*|hw/sh4/dyna|deps/vixl|rend/gles)/[^ ]*\.(c|cpp|S)$|arm7_rec[^/]*\.cpp$|dsp_(arm32|arm64|x64|x86)\.cpp$|core/linux/(posix_vmem|common|unwind_info)\.cpp$'

# _dlsym is allowed for compiler-rt's @available checks, as in Cores/vktest. Threads are allowed: Flycast
# loads custom textures and runs its scheduler helpers on them.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_gethostbyname$|_dlopen$|_mprotect$|_mmap$|_vm_protect$|_mach_vm_remap$|_shm_open$|_sigaction$|_sys_icache_invalidate$|_sys_dcache_flush$|_pthread_jit_write_protect_np$'
