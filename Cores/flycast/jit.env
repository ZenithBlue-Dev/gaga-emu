# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh flycast sources this after core.env
# and writes build/cores-jit/FlycastCore.xcframework; build/cores is untouched. The DevJIT configuration alone embeds
# it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else. Shell syntax.
#
# Upstream's SH-4 ARM64 recompiler (rec-ARM64, vixl) with TARGET_NO_AREC, upstream's own switch for SH-4 JIT with the
# ARM7 and AICA DSP interpreters: the ARM7 recompiler has no runtime switch back to the interpreter, and the DSP one
# runs its RW pointer on iOS. FEAT_NO_RWX_PAGES is upstream's Switch path: code is emitted through an RW pointer and
# every branch, block link and absolute address is computed against RX (cc_rx_offset). FlycastJit26.cpp serves that
# pair from Cores/shared/Jit26.c. No fastmem and no fault handler: virtmem::init stays false (FlycastSupport.cpp).
# Two count-checked build-time copies:
# - emulator.cpp: the SH-4 executor is the recompiler only while gaga_flycast_sh4_jit() (a debugger region in use and
#   GAGA_JIT=1 now), not config::DynarecEnabled; loadGame first calls gaga_flycast_engage_jit, which re-initialises the
#   recompiler on a Jit26 region. retro_init runs before the host sets GAGA_JIT, so Init alone cannot decide.
# - blockmanager.cpp: no block is write-protected. Protection needs page faults; every block checks its SH-4 code instead.

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/flycast"
jit_flags="-DGAGA_CORE_JIT -DTARGET_NO_AREC -DFEAT_NO_RWX_PAGES -DVIXL_CODE_BUFFER_MALLOC -Iupstream/core/deps/vixl"
CORE_CFLAGS="$jit_flags ${CORE_CFLAGS/-DTARGET_NO_REC /}"
CORE_CXXFLAGS="$jit_flags ${CORE_CXXFLAGS/-DTARGET_NO_REC /}"

# The SH-4 recompiler and vixl's AArch64 assembler are this build's purpose; the other back ends, the ARM7 and DSP
# recompilers, upstream's mmap code memory and its fault handler stay out.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|arm7_rec|dsp_arm64|prepare_jit_block failed'
FORBIDDEN_SOURCES='core/(rec-(ARM|x64|x86)|rend/gles|deps/vixl/aarch32)/[^ ]*\.(c|cc|cpp|S)$|arm7_rec[^/]*\.cpp$|dsp_(arm32|arm64|x64|x86)\.cpp$|core/linux/(posix_vmem|common)\.cpp$'
# core.env's list without _vm_protect and _sys_icache_invalidate, which ALLOWED_IMPORTS reviews below.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_gethostbyname$|_dlopen$|_mprotect$|_mmap$|_mach_vm_remap$|_shm_open$|_sigaction$|_sys_dcache_flush$|_pthread_jit_write_protect_np$'
# Jit26.c: vm_remap and vm_protect make the RW alias; sys_icache_invalidate runs its probe and FlycastJit26.cpp's flush.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
# vixl's code-buffer-vixl.cc has an mmap path that VIXL_CODE_BUFFER_MALLOC leaves out.
SOURCE_AUDIT_REVIEWED='^(\.\./shared/Jit26\.c|FlycastJit26\.cpp|upstream/core/deps/vixl/[a-z0-9/_-]+\.cc):'
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt and the three copies. Run from Cores/flycast.
core_jit_prepare() {
    local name rest list="$jit_out/sources.txt" emu="$jit_out/emulator.cpp" bm="$jit_out/blockmanager.cpp" drv="$jit_out/driver.cpp"
    mkdir -p "$jit_out"
    { echo 'class Sh4Executor; void gaga_flycast_engage_jit(Sh4Executor*); bool gaga_flycast_sh4_jit();'
      sed -e 's/if(config::DynarecEnabled)/if(gaga_flycast_sh4_jit())/' \
          -e '/^void Emulator::loadGame(/,/init();/s/^\([[:space:]]*\)init();$/\1init(); gaga_flycast_engage_jit(recompiler);/' \
          upstream/core/emulator.cpp
    } >"$emu"
    [ "$(grep -c 'if(gaga_flycast_sh4_jit())' "$emu")" = 2 ] && [ "$(grep -c 'gaga_flycast_engage_jit(recompiler);' "$emu")" = 1 ] ||
        { echo "jit.env: upstream's emulator.cpp changed; review the copy" >&2; return 1; }
    sed 's/if (!IsOnRam(addr) || (addr & 0x1FFF0000) == 0x0c000000)/if (true) \/\/ GagaEmu JIT: no page protection, so every block checks its code/' \
        upstream/core/hw/sh4/dyna/blockmanager.cpp >"$bm"
    [ "$(grep -c 'if (true) // GagaEmu JIT' "$bm")" = 1 ] ||
        { echo "jit.env: upstream's blockmanager.cpp changed; review the copy" >&2; return 1; }
    # gaga_flycast_engage_jit runs Term and Init again on a code cache that already holds the dispatcher. Upstream's
    # Init never rewinds the buffer (only ResetCache does), so the second mainloop starts past the base and its
    # verify(arm64_intc_sched == getBase()) stops the app (device run, 2026-11-14). The copy rewinds it in Init.
    sed 's/^	TempCodeCache = CodeCache + CODE_SIZE;$/& codeBuffer.reset(false); codeBuffer.reset(true); \/\/ GagaEmu JIT: Init may run again/' \
        upstream/core/hw/sh4/dyna/driver.cpp >"$drv"
    [ "$(grep -c 'GagaEmu JIT: Init may run again' "$drv")" = 1 ] ||
        { echo "jit.env: upstream's driver.cpp changed; review the copy" >&2; return 1; }
    while read -r name rest; do
        [ "$name" != upstream/core/emulator.cpp ] || name="$emu -iquote upstream/core"
        echo "$name${rest:+ $rest}"
    done <sources.txt >"$list"
    { echo ../shared/Jit26.c
      echo FlycastJit26.cpp
      echo "$bm -iquote upstream/core/hw/sh4/dyna"
      echo "$drv -iquote upstream/core/hw/sh4/dyna"
      for name in decoder shil ssa; do echo "upstream/core/hw/sh4/dyna/$name.cpp"; done
      echo upstream/core/rec-ARM64/rec_arm64.cpp
      echo upstream/core/linux/unwind_info.cpp
      for name in code-buffer-vixl compiler-intrinsics-vixl cpu-features utils-vixl; do echo "upstream/core/deps/vixl/$name.cc"; done
      for name in assembler assembler-sve instructions macro-assembler macro-assembler-sve operands registers pointer-auth; do
          echo "upstream/core/deps/vixl/aarch64/$name-aarch64.cc"
      done
    } >>"$list"
}
