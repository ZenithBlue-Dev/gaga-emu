# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=BeetlePceFastCore
CORE_EXPORT=_BeetlePceFast_GetInterface
CORE_VERSION=1.31.0

# Source of truth: https://github.com/libretro/beetle-pce-fast-libretro, the URL libretro-super builds from.
# GPL-2.0 (COPYING; the Mednafen files say "version 2 or later"). No release tags, so this pins the master
# commit of 2026-10-30. The core is plain C: a HuC6280 interpreter, no recompiler exists in the tree.
UPSTREAM_TAG=
UPSTREAM_COMMIT=2de1ce1c3f237b161c126c54ba407990bb86d1e9

# upstream/Makefile is not run. These match its defaults (FRONTEND_SUPPORTS_RGB565, USE_CHEATS, NEED_CD,
# NEED_BLIP, NEED_TREMOR, HAVE_CHD, MEDNAFEN_VERSION_NUMERIC=931) and its ios-arm64 HAVE_UNISTD_H, with these
# differences: HAVE_CDROM stays off (no physical drive), CACHE_CD stays off, and LZMA has no assembly.
# fdopen=fdopen: zlib's zutil.h replaces fdopen with NULL when it thinks it is on classic Mac OS, which breaks
# the SDK's stdio.h; its #ifndef fdopen guard keeps the real one (as Cores/mupen64plus_next/flags.h).
core_defines='-DNDEBUG -D_DARWIN_C_SOURCE -D__LIBRETRO__ -DHAVE_UNISTD_H -DWANT_PCE_FAST_EMU -Dfdopen=fdopen
  -DFRONTEND_SUPPORTS_RGB565 -DUSE_CHEATS -DNEED_CD -DNEED_TREMOR -DHAVE_CHD -D_7ZIP_ST -DZSTD_DISABLE_ASM
  -DMEDNAFEN_VERSION_NUMERIC=931 -DSTDC_HEADERS -D__STDC_LIMIT_MACROS -D_LOW_ACCURACY_ -DINLINE=inline'
core_includes='-I../shared -Iupstream -Iupstream/mednafen -Iupstream/mednafen/include -Iupstream/mednafen/hw_sound
  -Iupstream/mednafen/hw_cpu -Iupstream/mednafen/hw_misc -Iupstream/libretro-common/include
  -Iupstream/deps/lzma-19.00/include -Iupstream/deps/libchdr/include -Iupstream/deps/zstd/lib
  -Iupstream/deps/zlib-1.2.11'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS=''

# From the source audit in docs/03 section 5. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
