# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=ProSystemCore
CORE_EXPORT=_ProSystem_GetInterface
CORE_VERSION=1.3e

# Source of truth: https://github.com/libretro/prosystem-libretro, the libretro port of Greg Stanton's ProSystem.
# GPL-2.0-or-later (core/), BupBoop coretone zlib (bupboop/), libretro-common MIT. Upstream has no tags, so this
# pins the master commit of 2026-08-22.
UPSTREAM_TAG=
UPSTREAM_COMMIT=8a88014287c7a01cd568067e5a557d0a2b2a051f

# upstream/Makefile is not run. These match Makefile.common. GIT_VERSION stays undefined, so the version is "1.3e".
core_includes='-I../shared -Iupstream/core -Iupstream/libretro-common/include'
CORE_CFLAGS="-std=gnu11 -O2 -DNDEBUG $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="$CORE_CFLAGS"

# Sally is a 6502 interpreter. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# Offline and never loads code.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$|_pthread_create$'
