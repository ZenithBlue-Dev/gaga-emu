# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=Mupen64PlusNextCore
CORE_EXPORT=_Mupen64PlusNext_GetInterface
CORE_VERSION=3.0

# Source of truth: https://github.com/libretro/mupen64plus-libretro-nx, the URL libretro-super builds from.
# GPL-2.0 or later. Pinned to the develop commit of 2026-10-22; upstream has no release tags for this line.
UPSTREAM_TAG=
UPSTREAM_COMMIT=15bada85906593376e8fd697f1b0b3af3a20f512

# upstream/Makefile is not run. These match its platform=ios-arm64 build (WITH_DYNAREC empty, LLE=1,
# HAVE_PARALLEL_RDP=1, NO_ASM), with these differences (milestone 5.2, docs/07):
# - No HAVE_PARALLEL_RSP: rsp_jit.cpp, jit_allocator.cpp and GNU Lightning are not compiled. The RSP is
#   cxd4, an interpreter (HAVE_LLE), which is what upstream itself falls back to on iOS without JIT.
# - No WITH_DYNAREC and no new_dynarec file. The R4300 runs the pure interpreter (core option below).
# - No GLideN64, glsm or glsym, and no OpenGL ES: GLideN64 is not an accepted renderer (docs/05). nogl.c
#   stands in for the few GLideN64 and glsm symbols libretro.c still names. Video is paraLLEl-RDP on Vulkan.
# - No HAVE_THR_AL (Angrylion) and no libpng: neither is reached.
# - custom/ios/compat.c is not compiled: it only defines __clear_cache for the dynarec.
# - No libretro-common NEON assembly (NO_ASM): the C converters are used.
core_defines='-DNDEBUG -DIOS -DOS_IOS -DNO_ASM -DHAVE_POSIX_MEMALIGN -DHAVE_LLE -DHAVE_PARALLEL_RDP
  -DGRANITE_VULKAN_MT -D__STDC_CONSTANT_MACROS -D__STDC_LIMIT_MACROS -D__LIBRETRO__ -DUSE_FILE32API
  -DM64P_PLUGIN_API -DM64P_CORE_PROTOTYPES -D_ENDUSER_RELEASE -DSINC_LOWER_QUALITY -DMUPENPLUSAPI
  -DGAGA_LIBRETRO_VULKAN -DHAVE_OPENGLES -DHAVE_OPENGLES3 -DGLES3 -DGLES_SILENCE_DEPRECATION'
# The GL defines are upstream's ios-arm64 GLFLAGS. They only let libretro.c's glsm header parse: no GL file
# is compiled and OpenGLES is not linked.
up=upstream
core_includes="-I. -I../shared -I../../build/moltenvk/include -I$up/custom -I$up/custom/mupen64plus-core
  -I$up/custom/GLideN64 -I$up/GLideN64/src -I$up/GLideN64/src/osal -I$up/GLideN64/src/inc
  -I$up/mupen64plus-core/src -I$up/mupen64plus-core/src/api -I$up/custom/mupen64plus-core/plugin/audio_libretro
  -I$up/libretro-common/include -I$up/libretro -I$up/mupen64plus-core/subprojects/minizip
  -I$up/mupen64plus-core/subprojects/md5 -I$up/xxHash -I$up/custom/dependencies/libzlib
  -I$up/mupen64plus-video-paraLLEl/parallel-rdp/parallel-rdp -I$up/mupen64plus-video-paraLLEl/parallel-rdp/volk
  -I$up/mupen64plus-video-paraLLEl/parallel-rdp/vulkan -I$up/mupen64plus-video-paraLLEl/parallel-rdp/vulkan-headers/include
  -I$up/mupen64plus-video-paraLLEl/parallel-rdp/util"
CORE_CFLAGS="-std=gnu11 -O3 -fno-strict-aliasing -fsigned-char -include flags.h $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++17 -O3 -fno-strict-aliasing -fsigned-char -include flags.h $core_defines $core_includes -Wno-everything"
# The libretro audio backend resamples with AudioConverter on Apple platforms.
CORE_LDFLAGS='-framework AudioToolbox'

# MoltenVK and the adapter's layer path (docs/05 section 2.3).
CORE_USES_MOLTENVK=1

# From the source audit in docs/03 section 5. Bare "jit" and "dynarec" are not used: the core options' help
# text names "dynamic_recompiler", and machine-code bytes can match short words. FORBIDDEN_SOURCES below is
# the stronger check.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|new_dynarec|rsp_jit|jit_allocator'

# Checked against the dSYM: no file of the R4300 dynarec, the paraLLEl-RSP JIT, GNU Lightning or GLideN64's
# renderer. GLideN64/src/osal (file helpers that retro_init uses) is the one GLideN64 folder compiled.
FORBIDDEN_SOURCES='(new_dynarec|mupen64plus-rsp-paraLLEl|lightning|glsm|glsym)/[^ ]*\.(c|cpp|S)$|GLideN64/src/([^o/][^/]*/)*[^/]*\.(c|cpp)$|custom/GLideN64/.*\.cpp$'

# _dlsym is allowed for compiler-rt's @available checks, as in Cores/vktest. dlopen is not: volk's loader
# path is replaced in flags.h, so the Vulkan entry point comes only from the frontend.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_mprotect$|_vm_protect$|_sys_icache_invalidate$|_sys_dcache_flush$'
