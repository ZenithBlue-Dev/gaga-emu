# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh mupen64plus_next sources this after
# core.env and writes build/cores-jit/Mupen64PlusNextCore.xcframework; build/cores is untouched. The DevJIT
# configuration alone embeds it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else.
# Shell syntax.
#
# Upstream's R4300 ARM64 dynarec (new_dynarec, as its Makefile builds WITH_DYNAREC=aarch64: NEW_DYNAREC=4, DYNAREC,
# no NO_ASM), on memory from Cores/shared/Jit26.c: the translation cache runs at the RX address and is written through
# the RW alias, upstream's DOUBLE_CACHE_ADDR path. mupen64plus-cpucore becomes "dynamic_recompiler" only when the
# Jit26 probe ran and the 32 MiB cache region was mapped (MupenJit26.c); "cached_interpreter" when the probe ran but the
# region was not; otherwise the locked "pure_interpreter". The RSP stays cxd4 (interpreter): no paraLLEl-RSP, no GNU
# Lightning. core_jit_prepare writes build-time copies (count-checked) and the asm_defines offsets header.

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/mupen64plus_next"
# GAGA_JIT_OPTION_VALUE is a call: LibretroAdapterJit26.c reads it only after gaga_jit26_wanted (MupenJit26.h).
jit_flags="-DGAGA_CORE_JIT -DGAGA_JIT_OPTION_KEY=\"mupen64plus-cpucore\" -DGAGA_JIT_OPTION_VALUE=gaga_mupen_cpucore() -DDYNAREC -DNEW_DYNAREC=4"
[ "$(grep -o -- '-DNO_ASM' <<<"$CORE_CFLAGS" | wc -l | tr -d ' ')" = 1 ] || { echo "jit.env: core.env's -DNO_ASM changed; review" >&2; return 1; }
# NO_ASM is upstream's no-dynarec switch (r4300_core.c, cp0.c, interrupt.c); no other compiled file reads it.
CORE_CFLAGS="$jit_flags ${CORE_CFLAGS/-DNO_ASM/}"
CORE_CXXFLAGS="$jit_flags ${CORE_CXXFLAGS/-DNO_ASM/}"

# The R4300 dynarec is the point of this build. The RSP JIT, GNU Lightning and GLideN64 stay out.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|rsp_jit|jit_allocator'
FORBIDDEN_SOURCES='(mupen64plus-rsp-paraLLEl|lightning|glsm|glsym)/[^ ]*\.(c|cpp|S)$|GLideN64/src/([^o/][^/]*/)*[^/]*\.(c|cpp)$|custom/GLideN64/.*\.cpp$'
case "$FORBIDDEN_IMPORTS" in *'|_vm_protect$|_sys_icache_invalidate$|'*) ;; *) echo "jit.env: core.env's FORBIDDEN_IMPORTS changed; review" >&2; return 1 ;; esac
FORBIDDEN_IMPORTS="${FORBIDDEN_IMPORTS/|_vm_protect\$|_sys_icache_invalidate\$|/|}|_pthread_jit|_shm_open$|___clear_cache$"
# Jit26.c: vm_remap and vm_protect make the RW alias; sys_icache_invalidate runs its probe and the dynarec's flushes.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
# The dynarec's code-generation calls are the reviewed purpose of this build (the copy's unused upstream branches too).
SOURCE_AUDIT_REVIEWED="^(\.\./shared/Jit26\.c|$jit_out/ndrc/new_dynarec\.c):"
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt, the ndrc/ copies and asm_defines/asm_defines_gas.h. Run from Cores/mupen64plus_next.
core_jit_prepare() {
    local name rest dyn=upstream/mupen64plus-core/src/device/r4300/new_dynarec list="$jit_out/sources.txt"
    local ndrc="$jit_out/ndrc" defs="$jit_out/asm_defines" f
    rm -rf "$ndrc" "$defs"
    mkdir -p "$ndrc/arm64" "$defs"
    _jit_count() { [ "$(grep -cF -- "$2" "$1")" = "$3" ] || { echo "jit.env: $1: expected $3 of '$2'; upstream changed, review the copy" >&2; return 1; }; }

    # new_dynarec.c: DOUBLE_CACHE_ADDR on a Jit26 region kept for the process (init and cleanup run again on every
    # reset and state load), instead of shm_open and a second mmap; cleanup leaves it mapped.
    awk '
        /^  int fd = shm_open\("\/new_dynarec"/ { print "  base_addr_rx = gaga_mupen_jit_region(); // jit.env: Jit26 RX region"; print "  base_addr = gaga_jit26_writable(base_addr_rx);"; skip = 1; next }
        skip && /^  close\(fd\);$/ { skip = 0; next }
        !skip
    ' "$dyn/new_dynarec.c" |
        sed -e 's/^#define CACHE_ADDR FIXED_CACHE_ADDR$/#define CACHE_ADDR DOUBLE_CACHE_ADDR \/\/ jit.env/' \
            -e 's/^    if (munmap (base_addr_rx, 1<<TARGET_SIZE_2) < 0) {DebugMessage(M64MSG_ERROR, "munmap() failed");}$/    \/\/ jit.env: the Jit26 region stays mapped for the next init/' \
            >"$ndrc/new_dynarec.c"
    _jit_count "$ndrc/new_dynarec.c" 'gaga_mupen_jit_region()' 1 || return 1
    _jit_count "$ndrc/new_dynarec.c" 'shm_open' 0 || return 1
    _jit_count "$ndrc/new_dynarec.c" '#define CACHE_ADDR DOUBLE_CACHE_ADDR // jit.env' 1 || return 1
    _jit_count "$ndrc/new_dynarec.c" 'munmap (base_addr_rx' 0 || return 1

    # assem_arm64.h: Apple reserves x18 and the kernel may clear it, so the allocator never takes it (EXCLUDE_REG),
    # and x28 leaves the allocator too (HOST_REGS 28) to be the trampolines' scratch in x18's place.
    sed -e 's/^#define HOST_REGS 29$/#define HOST_REGS 28 \/\/ jit.env: x28 is the trampoline scratch/' \
        -e 's/^#define EXCLUDE_REG 29 \/\* FP \*\/$/#define EXCLUDE_REG 18 \/\/ jit.env: x18, Apple platform register/' \
        "$dyn/arm64/assem_arm64.h" >"$ndrc/arm64/assem_arm64.h"
    _jit_count "$ndrc/arm64/assem_arm64.h" '#define HOST_REGS 28 // jit.env' 1 || return 1
    _jit_count "$ndrc/arm64/assem_arm64.h" '#define EXCLUDE_REG 18 // jit.env' 1 || return 1
    # assem_arm64.c: far-call trampolines load and branch through x28, not x18. Flushes go to the RX alias through
    # sys_icache_invalidate, not EL0 cache instructions after an mrs ctr_el0.
    sed -e 's/^      \*ptr4=0x58000000|((8>>2)<<5)|18; \/\/ ldr x18,\[pc,#8\]$/      *ptr4=0x58000000|((8>>2)<<5)|28; \/\/ ldr x28,[pc,#8] (jit.env)/' \
        -e 's/^      \*(ptr4+1)=0xd61f0000|(18<<5);$/      *(ptr4+1)=0xd61f0000|(28<<5); \/\/ br x28 (jit.env)/' \
        -e 's/^  __clear_cache((char \*)base_addr+(1<<TARGET_SIZE_2)-JUMP_TABLE_SIZE,(char \*)base_addr+(1<<TARGET_SIZE_2));$/  cache_flush((char *)base_addr_rx+(1<<TARGET_SIZE_2)-JUMP_TABLE_SIZE,(char *)base_addr_rx+(1<<TARGET_SIZE_2)); \/\/ jit.env/' \
        -e 's/^static void cache_flush(char\* start, char\* end)$/static void cache_flush(char* start, char* end) { sys_icache_invalidate(start, (size_t)(end - start)); } \/\/ jit.env\
static void cache_flush_upstream(char* start, char* end)/' \
        "$dyn/arm64/assem_arm64.c" >"$ndrc/arm64/assem_arm64.c"
    _jit_count "$ndrc/arm64/assem_arm64.c" '|28; // ldr x28,[pc,#8] (jit.env)' 1 || return 1
    _jit_count "$ndrc/arm64/assem_arm64.c" '(28<<5); // br x28 (jit.env)' 1 || return 1
    _jit_count "$ndrc/arm64/assem_arm64.c" 'cache_flush((char *)base_addr_rx+(1<<TARGET_SIZE_2)-JUMP_TABLE_SIZE' 1 || return 1
    _jit_count "$ndrc/arm64/assem_arm64.c" '__clear_cache(' 0 || return 1
    _jit_count "$ndrc/arm64/assem_arm64.c" 'sys_icache_invalidate(start' 1 || return 1
    # No other x18 write in generated code: the remaining "18" register uses only move a value out of it.
    _jit_count "$ndrc/arm64/assem_arm64.c" '|18;' 0 || return 1

    # linkage_arm64.S is ELF-only: Mach-O wants _-prefixed symbols, @PAGE/@PAGEOFF, L-local labels, no .type/.size/
    # .hidden, and "%%" as the statement separator (";" starts a comment).
    { echo '#define GLOBAL_FUNCTION(name) .globl _##name %% .private_extern _##name %% _##name'
      echo '#define LOCAL_FUNCTION(name) _##name'
      sed -E -e '/^#define GLOBAL_FUNCTION\(name\)  \\$/,/^    \.size   name, size_$/d' \
          -e 's/^(    adrp +x[0-9]+, )(g_dev|base_addr_rx)$/\1_\2@PAGE/' \
          -e 's/:lo12:(g_dev|base_addr_rx)$/_\1@PAGEOFF/' \
          -e 's/^(    (b|bl|b\.[a-z]+) +)([A-Za-z_][A-Za-z0-9_]*)$/\1_\3/' \
          -e 's/^(    b\.ne +)\.([DE]1)$/\1L\2/' -e 's/^\.([DE]1):$/L\1:/' \
          "$dyn/arm64/linkage_arm64.S"
    } >"$ndrc/arm64/linkage_arm64.S"
    f="$ndrc/arm64/linkage_arm64.S"
    _jit_count "$f" '.type' 0 || return 1
    _jit_count "$f" '.hidden' 0 || return 1
    _jit_count "$f" ':lo12:' 0 || return 1
    _jit_count "$f" '@PAGE' 4 || return 1
    _jit_count "$f" 'GLOBAL_FUNCTION(' 39 || return 1
    _jit_count "$f" 'LOCAL_FUNCTION(' 2 || return 1
    _jit_count "$f" '    bl     _' 12 || return 1
    _jit_count "$f" '    b      _jump_vaddr' 26 || return 1
    _jit_count "$f" 'LD1' 2 || return 1
    _jit_count "$f" 'LE1' 2 || return 1

    # asm_defines_gas.h, as upstream's Makefile makes it: struct offsets read back from an object compiled with this
    # build's flags (one arm64 layout for both slices).
    # shellcheck disable=SC2086 # the flag string is a word list.
    xcrun --sdk iphoneos clang -target "arm64-apple-ios${min_ios:-17.0}" -I"$root/Sources/Bridge" $CORE_CFLAGS \
        -c upstream/mupen64plus-core/src/asm_defines/asm_defines.c -o "$defs/asm_defines.o" || return 1
    strings -a "$defs/asm_defines.o" | tr -d '\r' | awk -v dest_dir="$defs" -f upstream/mupen64plus-core/tools/gen_asm_defines.awk
    rm -f "$defs/asm_defines.o" "$defs/asm_defines_nasm.h"
    for f in device_r4300 r4300_core_new_dynarec_hot_state new_dynarec_hot_state_dynarec_local \
        new_dynarec_hot_state_cycle_count new_dynarec_hot_state_pending_exception new_dynarec_hot_state_pcaddr \
        new_dynarec_hot_state_stop; do
        _jit_count "$defs/asm_defines_gas.h" "#define offsetof_struct_${f} (0x" 1 || return 1
    done

    while read -r name rest; do
        case "$name" in
            ../shared/LibretroAdapter.c) name=../shared/LibretroAdapterJit26.c rest="-include MupenJit26.h${rest:+ $rest}" ;;
        esac
        echo "$name${rest:+ $rest}"
    done <sources.txt >"$list"
    { echo ../shared/Jit26.c
      echo MupenJit26.c
      # Its other quoted includes resolve against upstream's folder; arm64/ resolves to the copies beside it.
      echo "$ndrc/new_dynarec.c -include MupenJit26.h -include libkern/OSCacheControl.h -iquote $dyn"
      echo "$ndrc/arm64/linkage_arm64.S -I$defs"
    } >>"$list"
}
