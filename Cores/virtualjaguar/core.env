# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=VirtualJaguarCore
CORE_EXPORT=_VirtualJaguar_GetInterface
CORE_VERSION=3.11.0

# Source of truth: https://github.com/libretro/virtualjaguar-libretro, libretro's Virtual Jaguar. GPL-3.0-or-later,
# with libchdr (BSD-3-Clause; its LZMA public domain, zstd BSD, miniz MIT) and libretro-common (MIT). Pinned to
# release tag v3.11.0.
UPSTREAM_TAG=v3.11.0
UPSTREAM_COMMIT=34696082dbc0448caf23aa4ecb5ed40817cb8da0

# upstream/Makefile is not run. These match Makefile.common for platform ios-arm64 (NEON blitter) and the libchdr
# unity build's defines. -I. comes first so version.h here stands in for the generated one.
core_defines='-DNDEBUG -D__LIBRETRO__ -DINLINE=inline -DBLITTER_SIMD_NEON -D_7ZIP_ST -DMINIZ_DEFLATE_APIS -DWANT_RAW_DATA_SECTOR=1 -DWANT_SUBCODE=1 -DVERIFY_BLOCK_CRC=1'
core_includes='-I. -I../shared -Iupstream -Iupstream/src -Iupstream/src/core -Iupstream/src/tom -Iupstream/src/jerry -Iupstream/src/cd -Iupstream/src/bios -Iupstream/src/m68000 -Iupstream/src/debug -Iupstream/libretro-common/include -Iupstream/deps/libchdr/include -Iupstream/deps/libchdr/deps/lzma-25.01/include -Iupstream/deps/libchdr/deps/miniz-3.1.1 -Iupstream/deps/libchdr/deps/zstd-1.5.7'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="$CORE_CFLAGS"

# The 68000 (UAE-derived cpuemu tables), GPU and DSP RISC cores are interpreters. Bare "jit" is not used.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# Offline: JagLink TCP/UDP and the GDB stub are built from their socketless branches (nonet_*.c), so no socket
# call may appear. Never loads code.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_sendto$|_recvfrom$|_dlopen$|_dlsym$|_mprotect$|_pthread_create$'

# Atari's boot ROMs (src/bios/*.c) are never compiled; bios_stub.c stands in.
FORBIDDEN_SOURCES='src/bios/jag[a-z_]*\.c$'
