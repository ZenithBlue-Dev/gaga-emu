# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=GambatteCore
CORE_EXPORT=_Gambatte_GetInterface
CORE_VERSION=0.5.0

# Source of truth: https://github.com/libretro/gambatte-libretro, the URL libretro-super builds from.
# GPL-2.0. The repository has no release tags, so this pins the master commit of 2026-10-30.
UPSTREAM_TAG=
UPSTREAM_COMMIT=77f2567d718b8973d02caa2daa8dce4953faf811

# upstream/Makefile is not run. These match its DEFINES, minus HAVE_NETWORK (which upstream turns on for iOS,
# and which is link cable play over sockets). VIDEO_RGB565 is upstream's default: its XRGB8888 path gives 5-bit
# values with colour correction on, which is nearly black. HAVE_NO_LANGEXTRA drops the option translations.
core_defines='-DNDEBUG -D_DARWIN_C_SOURCE -D__LIBRETRO__ -DVIDEO_RGB565 -DHAVE_STDINT_H -DHAVE_INTTYPES_H -DHAVE_NO_LANGEXTRA'
core_includes='-I../shared -Iupstream/libgambatte/libretro-common/include -Iupstream/libgambatte/libretro -Iupstream/libgambatte/include -Iupstream/libgambatte/src -Iupstream/common -Iupstream/common/resample'
CORE_CFLAGS="-std=gnu11 -O3 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++11 -O3 $core_defines $core_includes -Wno-everything"

# From the source audit in docs/03 section 5. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
