# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=FbneoCore
CORE_EXPORT=_Fbneo_GetInterface
CORE_VERSION=1.0.0.03

# Non-commercial licence (upstream/src/license.txt, docs/03 section 5): sideload builds only. scripts/nojit-gate.sh
# and scripts/appstore_release.sh refuse any App Store or TestFlight build that would link this core.
CORE_NONCOMMERCIAL=1

# Source of truth: https://github.com/libretro/FBNeo, the libretro repository of FinalBurn Neo and the URL
# libretro-super builds from. No release tags, so this pins the master commit of 2026-11-07.
UPSTREAM_TAG=
UPSTREAM_COMMIT=4cdb31f1729588fa42d4aa1c3d9ce2cdaed28618

# upstream/src/burner/libretro/Makefile is not run. sources.txt is its platform=ios-arm64 list (make -n), which
# needs no generator: upstream commits src/dep/generated and the Musashi m68kops.c. That list has no Cyclone
# (ARM32 asm, off for iOS) and no MIPS3 x64 recompiler (USE_X64_DRC=0; its folder is not in this tree). Every
# CPU core is an interpreter. Upstream compiles mips3_intf.cpp alone with SKIP_STDIO_REDEFINES; that file does
# no file I/O, so the libretro VFS redefinitions it skips change nothing there.
core_defines='-DNDEBUG -D__LIBRETRO__ -DIOS9 -DUSE_LIBRETRO_VFS -DUSE_SPEEDHACKS -DLSB_FIRST -DHAVE_UNISTD_H -DINCLUDE_7Z_SUPPORT -DINCLUDE_CHD_SUPPORT -DCHDR_SYSTEM_ZLIB -DZ7_PPMD_SUPPORT -DZ7_ST -D_FILE_OFFSET_BITS=64 -DGIT_DATE="261107" -DGIT_VERSION="GIT4cdb31f17"'
core_includes='-I../shared -Iupstream/src/burner/win32 -Iupstream/src/burner/libretro/libretro-common/include -Iupstream/src/burner/libretro -Iupstream/src/burn -Iupstream/src/cpu -Iupstream/src/burn/snd -Iupstream/src/burn/devices -Iupstream/src/intf -Iupstream/src/intf/input -Iupstream/src/intf/cd -Iupstream/src/intf/audio -Iupstream/src/burner'
for fbneo_dir in f8 hmcs40 i8039 i8051 i8085 i8x41 m377 m6805 tlcs900 tms32010 upd7725 upd7810 v60 t11 xa z80 z180 sh4 pic16c5x; do
    core_includes="$core_includes -Iupstream/src/cpu/$fbneo_dir"
done
for fbneo_dir in zlib lib7z dr_libs stb_vorbis r8brain; do
    core_includes="$core_includes -Iupstream/src/dep/libs/$fbneo_dir"
done
for fbneo_dir in capcom konami dataeast cave neogeo psikyo sega toaplan taito irem pce galaxian; do
    core_includes="$core_includes -Iupstream/src/burn/drv/$fbneo_dir"
done
core_includes="$core_includes -Iupstream/src/dep/generated -Iupstream/src/dep/libs -Iupstream/src/burner/libretro/deps/ugui -Iupstream/src/dep/libs/libchdr/include -Iupstream/src/dep/libs/lzma"
# no_thread.h keeps upstream's thready.h on its single-thread path (see that file).
core_common="-O3 -fomit-frame-pointer -ffast-math -frounding-math -fno-strict-aliasing $core_defines -include no_thread.h $core_includes -Wno-everything"
CORE_CFLAGS="-std=gnu99 $core_common -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++98 $core_common"

# Not bare "Cyclone": a ZX Spectrum game has that name.
FORBIDDEN_SOURCES='mips3_x64|xbyak|[Cc]yclone\.s'
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|Xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$|_sem_open$'
