# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
# A debug and test core written in this repository (VkTestCore.c): no upstream, never in a release build.
CORE_FRAMEWORK=VkTestCore
CORE_EXPORT=_VkTest_GetInterface
CORE_VERSION=0.1.0
UPSTREAM_TAG=
UPSTREAM_COMMIT=

# Links MoltenVK (scripts/build-moltenvk.sh) and the adapter's Vulkan layer path. The libretro headers come
# from the libretro-common pinned under melonds_ds: git submodule update --init Cores/melonds_ds/deps/libretro-common
CORE_USES_MOLTENVK=1
core_defines='-DNDEBUG -DGAGA_LIBRETRO_VULKAN'
core_includes='-I../shared -I../../build/moltenvk/include -I../melonds_ds/deps/libretro-common/include'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wall -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++17 -O2 $core_defines $core_includes"

# MoltenVK translates SPIR-V to MSL and Metal compiles that for the GPU. Nothing generates CPU code.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'
# _dlsym is allowed: MoltenVK's @available checks pull in compiler-rt's os_version_check.c, which looks up
# CoreFoundation functions with dlsym(RTLD_DEFAULT) to read SystemVersion.plist. It loads no code.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_mprotect$|_vm_protect$|_sys_icache_invalidate$'
