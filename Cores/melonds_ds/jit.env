# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh melonds_ds sources this after
# core.env and writes build/cores-jit/MelonDSCore.xcframework; build/cores is untouched. The DevJIT configuration
# alone embeds it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else. Shell syntax.
#
# melonDS's ARM64 recompiler (ARMJIT_A64, dolphin/Arm64Emitter), as upstream's CMake builds it with ENABLE_JIT and no
# fastmem (melonDS never enables fastmem on Apple). Its code memory comes from Cores/shared/Jit26.c (iOS 26 TXM: a
# debugger prepares an RX region, the emitter writes through an RW alias, as on upstream's Switch port).
# melonds_jit_enable becomes "enabled" only when that works; MelonDSCore.c serves "disabled" otherwise.

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/melonds_ds"
# No -include of Jit26.h: ARMJIT_Linkage.S takes these flags too. The files that need it include it.
jit_flags="-DGAGA_CORE_JIT -DJIT_ENABLED -DHAVE_JIT -DENABLE_JIT"
jit_flags="$jit_flags -DGAGA_JIT_OPTION_KEY=\"melonds_jit_enable\" -DGAGA_JIT_OPTION_VALUE=\"enabled\""
CORE_CFLAGS="$jit_flags $CORE_CFLAGS"
CORE_CXXFLAGS="$jit_flags $CORE_CXXFLAGS"

# The recompiler's names are the point of this build; the OpenGL, compute and network parts and the x64 back end
# stay out as in core.env.
FORBIDDEN_STRINGS='GLRenderer|GLCompositor|ComputeRenderer|Net_Slirp|asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::'
FORBIDDEN_DEBUG_STRINGS="$FORBIDDEN_STRINGS|ARMJIT_x64|x64Emitter\\.cpp|GPU_OpenGL\\.cpp|GPU2D_OpenGL\\.cpp|GPU3D_OpenGL\\.cpp|GPU3D_Compute\\.cpp|OpenGLSupport\\.cpp|render/opengl\\.cpp|Net_Slirp\\.cpp|Net_PCap\\.cpp"
# MelonDSJit26.h turns ARMJIT's pthread_jit_write_protect_np and fastmem's mprotect into no-ops.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$|_pthread_jit'
# Jit26.c: vm_remap and vm_protect make the RW alias, sys_icache_invalidate runs its probe.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
# Jit26.c's calls and the emitter's cache flush are the reviewed purpose of this build. ARMJIT.cpp's W^X flips
# (pthread_jit_write_protect_np, NetBSD's mprotect) are no-ops through MelonDSJit26.h or not compiled.
SOURCE_AUDIT_REVIEWED='^(\.\./shared/Jit26\.c|deps/melonDS/src/dolphin/Arm64Emitter\.cpp|deps/melonDS/src/ARMJIT\.cpp:(1163|1173|1175)):'
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt and the ARMJIT_Compiler.cpp copy. Run from Cores/melonds_ds.
core_jit_prepare() {
    local src=deps/melonDS/src list="$jit_out/sources.txt" copy="$jit_out/ARMJIT_Compiler.cpp" name
    mkdir -p "$jit_out"
    # Upstream maps one RWX region for both bases off the Switch. This copy gives the emitter the RW alias.
    { echo '#include "Jit26.h"'
      sed 's/SetCodeBase(reinterpret_cast<u8\*>(CodeMemBase), /SetCodeBase(reinterpret_cast<u8*>(gaga_jit26_writable(CodeMemBase)), /' \
          "$src/ARMJIT_A64/ARMJIT_Compiler.cpp"
    } >"$copy"
    [ "$(grep -c 'gaga_jit26_writable' "$copy")" = 1 ] || { echo "jit.env: upstream ARMJIT_Compiler.cpp changed; review the copy" >&2; return 1; }
    sed 's|^\.\./shared/LibretroAdapter\.c$|../shared/LibretroAdapterJit26.c|' sources.txt >"$list"
    { echo ../shared/Jit26.c
      echo ARMJIT_GlobalJit26.cpp
      for name in ARM_InstrInfo.cpp dolphin/CommonFuncs.cpp dolphin/Arm64Emitter.cpp dolphin/MathUtil.cpp \
          ARMJIT_A64/ARMJIT_ALU.cpp ARMJIT_A64/ARMJIT_LoadStore.cpp ARMJIT_A64/ARMJIT_Branch.cpp ARMJIT_A64/ARMJIT_Linkage.S; do
          echo "$src/$name"
      done
      echo "$src/ARMJIT.cpp -include MelonDSJit26.h"
      echo "$src/ARMJIT_Memory.cpp -include MelonDSJit26.h"
      # The copy's own includes are relative to upstream's ARMJIT_A64.
      echo "$copy -iquote $src/ARMJIT_A64"
    } >>"$list"
    [ "$(grep -c 'LibretroAdapterJit26' "$list")" = 1 ] || { echo "jit.env: sources.txt has no ../shared/LibretroAdapter.c" >&2; return 1; }
}
