# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=MelonDSCore
CORE_EXPORT=_MelonDS_GetInterface
CORE_VERSION=1.4.0

# Source of truth: https://github.com/JesseTG/melonds-ds, the URL libretro-super builds melondsds from.
# GPL-3.0-or-later. Its CMake fetches the rest at configure time; each one is a submodule in deps/ instead,
# pinned to the ref upstream's cmake/FetchDependencies.cmake names at this tag (docs/03 section 5).
UPSTREAM_TAG=v1.4.0
UPSTREAM_COMMIT=f394adbacb5722ee97c1b37c8064da9a25818310

# upstream/CMakeLists.txt is not run. These match what it sets for iOS with ENABLE_JIT, ENABLE_OPENGL,
# ENABLE_NETWORKING, ENABLE_DYNAMIC and ENABLE_ZLIB off: no JIT_ENABLED, no OGLRENDERER_ENABLED, no
# HAVE_NETWORKING, so no recompiler, OpenGL renderer, socket or dlopen code is compiled. include/ holds
# what CMake would generate: the two version headers and the asset declarations (MelonDSAssets.c).
core_defines='-DNDEBUG -D_DARWIN_C_SOURCE -DIOS=1 -DHAVE_COCOATOUCH -DHAVE_NEON -DHAVE_STRL -DHAVE_THREADS -DHAVE_GLSYM_PRIVATE -DHAVE_RPNG -DENABLE_THREADED_RENDERER -DHAVE_THREADED_RENDERER -DGLM_ENABLE_EXPERIMENTAL -DPNTR_ENABLE_DEFAULT_FONT -DPNTR_ENABLE_FILTER_SMOOTH -DPNTR_ENABLE_TTF -DPNTR_ENABLE_VARGS -DPNTR_PIXELFORMAT_ARGB -DPNTR_ENABLE_MATH -DSTB_IMAGE_STATIC'
core_includes='-I../shared -Iinclude -Iupstream/src/libretro -Ideps/libretro-common/include -Ideps/melonDS/src -Ideps/melonDS/src/net -Ideps/melonDS/src/teakra/include -Ideps/glm -Ideps/pntr -Ideps/yamc/include -Ideps/span-lite/include -Ideps/date/include -Ideps/fmt/include'
CORE_CFLAGS="-std=gnu11 -O3 -fwrapv $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
# C++17, as upstream's src/libretro and melonDS's src set CMAKE_CXX_STANDARD.
CORE_CXXFLAGS="-std=gnu++17 -O3 -fwrapv $core_defines $core_includes -include gaga_nonet.h -Wno-everything"

# Names only melonDS's recompiler (ARMJIT*.cpp, ARMJIT_A64/, dolphin/Arm64Emitter.cpp), its OpenGL and
# compute renderers or the slirp Wi-Fi driver define, and the docs/03 section 5 list. Not ARMJIT,
# ARMJIT_Memory or CompileBlock: the JIT-off build keeps empty stubs by those names. Bare "jit" is not
# used: machine-code bytes can match it.
FORBIDDEN_STRINGS='Arm64Gen|ARM64XEmitter|JitBlock|ARMJIT_Global|ARM_Dispatch|FastBlockLookup|A_Comp_|T_Comp_|GLRenderer|GLCompositor|ComputeRenderer|Net_Slirp|asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|dynarec'
# The same names in the debug info, which keeps what the binary strips, plus the source files themselves.
FORBIDDEN_DEBUG_STRINGS="$FORBIDDEN_STRINGS|ARMJIT\\.cpp|ARMJIT_[A-Za-z]+\\.cpp|ARMJIT_Linkage|Arm64Emitter\\.cpp|x64Emitter\\.cpp|GPU_OpenGL\\.cpp|GPU2D_OpenGL\\.cpp|GPU3D_OpenGL\\.cpp|GPU3D_Compute\\.cpp|OpenGLSupport\\.cpp|render/opengl\\.cpp|Net_Slirp\\.cpp|Net_PCap\\.cpp"

# Offline and never loads code. The threaded 3D renderer is the only thread (pthread_create is allowed).
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$'
