# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=MameCore
CORE_EXPORT=_Mame_GetInterface
CORE_VERSION=0.289

# Source of truth: https://github.com/libretro/mame, the libretro fork of https://github.com/mamedev/mame
# and the URL libretro-super builds mame from. MAME 0.289. GPL-2.0-or-later as a whole, most files
# BSD-3-Clause (docs/03 section 5). It has no tag for 0.289, so this pins the master commit of 2026-10-09.
UPSTREAM_TAG=
UPSTREAM_COMMIT=5f5a07748ce5c239c4118463ce8e6473743d4859

# Neither upstream makefile is run. generate.py wrote sources.txt and generated/ from the GENie projects
# upstream's Makefile.libretro makes for iOS (NOASM, DONT_USE_NETWORK, NO_OPENGL, NO_USE_MIDI,
# NO_USE_PORTAUDIO, no Qt, no BGFX, OSD "retro"), with the machines in drivers.flt. These are the union of
# those projects' defines and include paths. None of the machines has a recompiling CPU, so no DRC file is
# compiled at all, C backend included.
core_defines='-D__LIBRETRO__ -DNDEBUG -DTARGET_OS_IPHONE -DCRLF=2 -DLSB_FIRST -DFLAC__NO_DLL -DPUGIXML_HEADER_ONLY -DMAME_NOASM -DNATIVE_DRC=drcbe_c -DHAVE_IMMINTRIN_H=0 -DSDL_DISABLE_IMMINTRIN_H=1 -DHAVE_SSE=0 -DLUA_USE_POSIX -DUTF8PROC_STATIC'
c_defines='-DZLIB_CONST -DSQLITE_OMIT_LOAD_EXTENSION -DZ7_PPMD_SUPPORT -DZ7_ST -DUSE_UTF8 -DXXH_NAMESPACE=ZSTD_ -DDEBUGLEVEL=0 -DZSTD_DISABLE_ASM -DHAVE_CONFIG_H -DENABLE_64_BIT_WORDS=1 -DOGG_FOUND=0 -DFLAC__HAS_OGG=0 -DHAVE_LROUND=1 -DHAVE_INTTYPES_H -DHAVE_STDBOOL_H -DHAVE_STDINT_H -DHAVE_STDIO_H -DHAVE_STDLIB_H -DHAVE_STRING_H -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DHAVE_BSWAP16 -DHAVE_BSWAP32 -DCPU_IS_BIG_ENDIAN=0 -DCPU_IS_LITTLE_ENDIAN=1 -DWORDS_BIGENDIAN=0 -DFLAC__SYS_DARWIN -DHAVE_CXX11 -DHAVE_MEMMOVE -DXML_CONTEXT_BYTES=1024 -DXML_DTD -DXML_GE=1 -DXML_NS -DBYTEORDER=1234 -DHAVE_ARC4RANDOM -DHAVE_FCNTL_H -DHAVE_SYS_STAT_H -DHAVE_SYS_TYPES_H -DHAVE_UNISTD_H -DXML_DEV_URANDOM'
cxx_defines='-DSDLMAME_NO_X11 -DRETROMAME -DUSE_XINPUT=0 -DOSD_RETRO -DSDLMAME_UNIX -DRETROMAME_UNIX -DSDLMAME_MACOSX -DSDLMAME_DARWIN -D__STDC_LIMIT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_CONSTANT_MACROS -DNO_USE_MIDI -DNO_USE_PORTAUDIO -DNO_USE_BGFX -DUSE_QTDEBUG=0 -DUSE_OPENGL=0 -DNL_USE_ACADEMIC_SOLVERS=0 -DYMFM_MAME -DSOFTFLOAT_ROUND_ODD -DINLINE_LEVEL=5 -DSOFTFLOAT_FAST_DIV32TO16 -DSOFTFLOAT_FAST_DIV64TO32 -DSOFTFLOAT_FAST_INT64 -DLITTLEENDIAN=1'
u=upstream
c_includes="-I../shared -I$u/src/osd/libretro/libretro-internal -I$u/src/osd -I$u/3rdparty -I$u/3rdparty/flac/src/libFLAC/include -I$u/3rdparty/flac/include -I$u/3rdparty/linenoise -I$u/3rdparty/zlib -I$u/3rdparty/sqlite3"
# src/frontend/mame before src/lib/util: both have a language.h, and only the frontend's files include it.
cxx_includes="-I../shared -I$u/src/osd -I$u/src/emu -I$u/src/frontend/mame -I$u/src/devices -I$u/src/mame/shared -I$u/src/mame -I$u/src/lib -I$u/src/lib/util -I$u/src/lib/netlist -I$u/src/osd/modules/lib -I$u/src/osd/libretro -I$u/src/osd/libretro/libretro-internal -I$u/src/osd/interface -I$u/src/osd/modules/file -I$u/src/osd/modules/render -I$u/3rdparty -I$u/3rdparty/sol2 -I$u/3rdparty/asio/include -I$u/3rdparty/expat/lib -I$u/3rdparty/zlib -I$u/3rdparty/zstd/lib -I$u/3rdparty/flac/include -I$u/3rdparty/libjpeg -I$u/3rdparty/rapidjson/include -I$u/3rdparty/pugixml/src -I$u/3rdparty/glm -I$u/3rdparty/lua/src -I$u/3rdparty/linenoise -I$u/3rdparty/sqlite3 -I$u/3rdparty/utf8proc -I$u/3rdparty/softfloat3/build/MAME -I$u/3rdparty/softfloat3/source/include -I$u/3rdparty/softfloat3/source/8086 -I$u/3rdparty/softfloat3/bochs_ext -Igenerated -Igenerated/emu -Igenerated/emu/layout -Igenerated/mame/layout -I$u"
# -Os as upstream's Makefile.libretro builds iOS (OPTIMIZE=s). Every file gets upstream's forced prefix header.
common="-Os -fno-strict-aliasing -Wno-everything -include $u/src/osd/libretro/retroprefix.h $core_defines"
CORE_CFLAGS="-std=gnu99 $common $c_defines $c_includes"
# C++20 as upstream builds MAME. The Lua and SoftFloat files are C compiled as C++, by wrappers in generated/cxx.
CORE_CXXFLAGS="-std=c++20 $common $cxx_defines $cxx_includes"

# MAME's recompilers emit machine code through asmjit (drcbe_x64, drcbe_arm64); none is compiled here.
# Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|drcbe_x64|drcbe_arm64|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'
# The native back ends, asmjit, and the executable-memory OSD file MameOsdLib.cpp replaces.
FORBIDDEN_SOURCES='drcbex64\.cpp|drcbearm64\.cpp|3rdparty/asmjit|osdlib_retro\.cpp'

# Offline and never loads code: no web server, sockets or plugin libraries (MameSupport.cpp).
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$'
