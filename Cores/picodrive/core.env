# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=PicodriveCore
CORE_EXPORT=_Picodrive_GetInterface
CORE_VERSION=2.05

# Non-commercial licence (upstream/COPYING, docs/03 section 5): sideload builds only. scripts/nojit-gate.sh
# and scripts/appstore_release.sh refuse any App Store or TestFlight build that would link this core.
CORE_NONCOMMERCIAL=1

# Source of truth: https://github.com/libretro/picodrive, the libretro repository of notaz's and irixxxx's
# emulator and the URL libretro-super builds from. No release tags, so this pins the master commit of 2026-09-26.
# Its own submodules, at the commits it records: git -C Cores/picodrive/upstream submodule update --init
# --depth 1 pico/cd/libchdr platform/common/dr_libs platform/libpicofe. cpu/cyclone (ARM32 asm) is not needed.
UPSTREAM_TAG=
UPSTREAM_COMMIT=1890c2932234c9d30f4cd3851d02228baae8f09e
# Upstream's own submodules that sources.txt compiles; cpu/cyclone (ARM32 assembly) is not one.
CORE_UPSTREAM_SUBMODULES='pico/cd/libchdr pico/sound/emu2413 platform/common/dr_libs platform/libpicofe'

# upstream/Makefile.libretro is not run. sources.txt is its platform=ios-arm64 list (make -n), which on Apple
# already turns the SH-2 and SVP recompilers off: FAME/C for the 68000, CZ80 for the Z80, the MAME SH-2
# interpreter, the SSP1601 interpreter, no ARM asm. cpu/drc/cmn.c (the translation cache) and libretro-common
# memmap.c are left out: nothing in this build calls them.
core_defines='-DNDEBUG -D__LIBRETRO__ -DIOS -DUSE_LIBRETRO_VFS -DHAVE_ZLIB -DUSE_LIBCHDR -DEMU_F68K -D_USE_CZ80 -DUSE_TREMOR -DZ7_ST -DREVISION="-1890c293"'
core_includes='-I../shared -Iupstream -Iupstream/pico/cd/libchdr/deps/lzma-24.05/include -Iupstream/pico/cd/libchdr/include -Iupstream/zlib -Iupstream/pico/cd/libchdr/deps/zstd-1.5.6/lib'
for picodrive_dir in "" /compat /encodings /formats /streams /string /vfs; do
    core_includes="$core_includes -Iupstream/platform/libretro/libretro-common/include$picodrive_dir"
done
# For Tremor's <ogg/ogg.h>. After the SDK's own headers: on a case-blind disk its block.h would stand in for <Block.h>.
core_includes="$core_includes -idirafter upstream/platform/common/tremor"
# no_exec.h renames the three calls the dead recompiler glue in libretro.c makes (see that file).
CORE_CFLAGS="-std=gnu11 -O3 -fno-strict-aliasing -falign-functions=4 $core_defines -include no_exec.h $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++17 -O3 $core_defines $core_includes -Wno-everything"

# Reviewed hits of the source audit, all in upstream/platform/libretro/libretro.c: a PROT_EXEC fallback define
# (32), ARM32-only cache flushes (235, 243), the Mach __clear_cache it defines for compiler-made calls (280, 284),
# and plat_mem_set_exec (534), called only by cpu/drc/cmn.c, which this build leaves out. no_exec.h turns
# mprotect and the cache calls into stubs that do nothing, so the binary imports none of them.
SOURCE_AUDIT_REVIEWED='^upstream/platform/libretro/libretro\.c:(32|235|243|280|284|534):'

# The recompilers' source files. Their names must not reach the binary's debug info.
FORBIDDEN_SOURCES='cpu/sh2/compiler\.c|cpu/drc/|svp/compiler\.c|stub_arm|Cyclone|drz80'
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec|drc_cmn_init'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
