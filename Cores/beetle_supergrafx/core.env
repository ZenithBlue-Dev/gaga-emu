# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=BeetleSupergrafxCore
CORE_EXPORT=_BeetleSupergrafx_GetInterface
CORE_VERSION=1.29.0

# Source of truth: https://github.com/libretro/beetle-supergrafx-libretro, the URL libretro-super builds from.
# GPL-2.0 (COPYING; the Mednafen files say "version 2 or later"). No release tags, so this pins the master
# commit of 2026-10-06. A HuC6280 interpreter in C++; no recompiler exists in the tree.
UPSTREAM_TAG=
UPSTREAM_COMMIT=9c11dcd213a79d57d2c86313971631af801f2cdc

# upstream/Makefile is not run. These match what its Makefile.common and ios-arm64 target define (printed with
# make, not built), with these differences: HAVE_CDROM stays off (no physical drive) and nothing is assembly.
# CHD goes through libretro-common's rchd, so there is no zlib here.
core_defines='-DNDEBUG -D_DARWIN_C_SOURCE -D__LIBRETRO__ -DHAVE_UNISTD_H -DWANT_16BPP -DFRONTEND_SUPPORTS_RGB565
  -DNEED_CD -DHAVE_CHD -DHAVE_RCHD -DHAVE_RCHD_DEFLATE -DHAVE_RCHD_LZMA -DHAVE_RCHD_FLAC -DHAVE_RCHD_ZSTD
  -DHAVE_RFLAC -DHAVE_RZSTD -DNEED_TREMOR -DSIZEOF_DOUBLE=8 -DMEDNAFEN_VERSION=\"1.29.0\" -DPACKAGE=\"mednafen\"
  -DMEDNAFEN_VERSION_NUMERIC=1290 -DMPC_FIXED_POINT -DWANT_STEREO_SOUND -DSTDC_HEADERS -D__STDC_LIMIT_MACROS
  -D_LOW_ACCURACY_ -DINLINE=inline'
core_includes='-I../shared -Iupstream -Iupstream/mednafen -Iupstream/mednafen/include -Iupstream/mednafen/intl
  -Iupstream/mednafen/hw_sound -Iupstream/mednafen/hw_cpu -Iupstream/mednafen/hw_misc
  -Iupstream/libretro-common/include'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++11 -O2 $core_defines $core_includes -Wno-everything"

# From the source audit in docs/03 section 5. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
