# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh dosbox_pure sources this after
# core.env and writes build/cores-jit/DosboxPureCore.xcframework; build/cores is untouched. The DevJIT configuration
# alone embeds it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else. Shell syntax.
#
# Upstream's dynamic recompiler with its ARMv8 back end (core_dynrec.cpp, risc_armv8le.h), on memory from
# Cores/shared/Jit26.c (iOS 26 TXM: a debugger prepares an RX region, the recompiler writes through an RW alias).
# Without DISABLE_DYNAREC, include/config.h selects it for arm64, as upstream's own arm64 builds do. core_dynrec.cpp
# alone is compiled with HAVE_LIBNX: dyn_cache.h then keeps upstream's RX/RW split, and jit26/switch.h stands in for
# libnx. dosbox_pure_cpu_core becomes "dynamic" only when that works; otherwise "normal" (DosboxPureCore.c) as before.

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/dosbox_pure"
jit_flags='-DGAGA_CORE_JIT -DGAGA_JIT_OPTION_KEY="dosbox_pure_cpu_core" -DGAGA_JIT_OPTION_VALUE="dynamic"'
CORE_CFLAGS="$jit_flags ${CORE_CFLAGS//-DDISABLE_DYNAREC=1/}"
CORE_CXXFLAGS="$jit_flags ${CORE_CXXFLAGS//-DDISABLE_DYNAREC=1/}"

# The x86 recompiler and every other back end stay out; the ARMv8 one is the point of this build.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|CPU_Core_Dyn_X86'
FORBIDDEN_DEBUG_STRINGS='CPU_Core_Dyn_X86'
FORBIDDEN_SOURCES='core_dyn_x86(/[^ ]*)?\.(cpp|h)$|risc_(x64|x86|armv4le[^/ ]*|mipsel32|ppc)\.h$'
FORBIDDEN_IMPORTS="$FORBIDDEN_IMPORTS|_pthread_jit"
# Jit26.c: vm_remap and vm_protect make the RW alias, sys_icache_invalidate runs its probe.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
# Jit26.c's code-generation calls are the reviewed purpose of this build. The recompiler's own (dyn_cache.h) are
# headers, which the audit does not read, and their mprotect branch is off under HAVE_LIBNX.
SOURCE_AUDIT_REVIEWED='^\.\./shared/Jit26\.c:'
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt. Run from Cores/dosbox_pure.
core_jit_prepare() {
    local list="$jit_out/sources.txt"
    mkdir -p "$jit_out"
    sed 's|^\.\./shared/LibretroAdapter\.c$|../shared/LibretroAdapterJit26.c|' sources.txt >"$list"
    [ "$(grep -c 'LibretroAdapterJit26' "$list")" = 1 ] || { echo "jit.env: sources.txt changed; review the list" >&2; return 1; }
    { echo ../shared/Jit26.c
      echo "upstream/src/cpu/core_dynrec.cpp -DHAVE_LIBNX -Ijit26"
    } >>"$list"
}
