# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=DosboxPureCore
CORE_EXPORT=_DosboxPure_GetInterface
CORE_VERSION=1.0-preview7

# Source of truth: https://codeberg.org/schelling/dosbox-pure, where the author moved the project (the
# GitHub README at github.com/schellingb/dosbox-pure points there). GPL-2.0-or-later (docs/03 section 5).
UPSTREAM_TAG=1.0-preview7
UPSTREAM_COMMIT=cdaea10ce8cac231bc341ca05d4c5e4e5fe0fbd5

# upstream/Makefile is not run. These match its iOS flags: DISABLE_DYNAREC leaves C_DYNAMIC_X86 and C_DYNREC
# undefined in include/config.h, and sources.txt leaves out core_dyn_x86.cpp and core_dynrec.cpp, so only the
# interpreters (normal, simple, full, prefetch) are compiled.
core_defines='-DNDEBUG -D__LIBRETRO__ -DDISABLE_DYNAREC=1 -DDBP_IOS -D_FILE_OFFSET_BITS=64'
core_includes='-I../shared -Iupstream/include -Iupstream/libretro-common/include'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++11 -O2 -fomit-frame-pointer -fexceptions $core_defines $core_includes -Wno-everything"

# Names only the two recompilers define (CPU_Core_Dyn_X86_*, CPU_Core_Dynrec_*, their block caches and code
# generators). Bare "dynrec" is not used: config option strings name it.
FORBIDDEN_STRINGS='CPU_Core_Dyn_X86|CPU_Core_Dynrec|CacheBlockDynRec|CodePageHandlerDynRec|gen_runcode|dyn_run_code|cache_initialized'
# The same names in the debug info, which keeps what the binary strips.
FORBIDDEN_DEBUG_STRINGS="$FORBIDDEN_STRINGS"
# The dynamic recompiler's sources and headers must not appear in the debug info at all.
FORBIDDEN_SOURCES='(core_dyn_x86|core_dynrec)(/[^ ]*)?\.(cpp|h)$|dyn_cache\.h$'

# Offline and never loads code. Network play only runs through the libretro netpacket interface, which the
# adapter refuses, and the Voodoo OpenGL path only loads GL through SET_HW_RENDER, which the adapter also
# refuses: no socket or GL symbol may be imported. pthread_create is allowed (DOSBox runs on its own thread).
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$|_gl[A-Z]'
