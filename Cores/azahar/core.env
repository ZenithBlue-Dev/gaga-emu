# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
# Azahar, official upstream (azahar-emu/azahar) at a release tag, with its own libretro frontend
# (src/citra_libretro). GPL-2.0-or-later.
CORE_FRAMEWORK=AzaharCore
CORE_EXPORT=_Azahar_GetInterface
CORE_VERSION=2126.2
UPSTREAM_TAG=2126.2
UPSTREAM_COMMIT=219d743a1e698101fe1ab8bef43e6563126c3c27

# Upstream's own submodules that sources.txt compiles or includes, each at the commit upstream records.
# Dynarmic, oaknut and xbyak are not among them: no JIT is compiled. robin-map, which upstream takes from
# Dynarmic's tree, is deps/robin-map at the commit Dynarmic pins (cmake/tsl-robin-mapConfig.cmake).
CORE_UPSTREAM_SUBMODULES='externals/boost externals/cryptopp externals/fmt externals/inih/inih externals/faad2/faad2
    externals/library-headers externals/soundtouch externals/teakra externals/zstd externals/enet externals/libressl
    externals/lodepng/lodepng externals/spirv-headers externals/spirv-tools externals/glslang externals/sirit/sirit
    externals/vma externals/vulkan-headers externals/xxHash externals/libretro-common/libretro-common
    externals/nihstro externals/dds-ktx'

# sources.txt, cmake.env and generated/ come from upstream's CMake build: Cores/azahar/generate.py writes all
# three (iOS arm64, ENABLE_LIBRETRO, ENABLE_GENERIC, Vulkan and software renderers, no OpenGL, no built-in
# key blob). AzaharSupport.cpp is GagaEmu's own.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/cmake.env"

# Links MoltenVK (scripts/build-moltenvk.sh) and the adapter's Vulkan layer path.
CORE_USES_MOLTENVK=1
core_flags="-include flags.h -DGAGA_LIBRETRO_VULKAN -I. -I../shared -I../../build/moltenvk/include $cmake_flags"
core_flags="$core_flags -O2 -fno-strict-aliasing -Wno-everything -Werror=implicit-function-declaration"
CORE_CFLAGS="-std=gnu11 $core_flags"
CORE_CXXFLAGS="-std=gnu++20 $core_flags"
# bind goes to its refusing stand-in here, not in flags.h (see there).
CORE_LDFLAGS='-framework CoreFoundation -Wl,-alias,_gaga_azahar_no_bind,_bind'

# From the source audit in docs/03 section 5. Bare "jit" is not used: the option keys and their help text
# name the JIT settings that this build reads as off. FORBIDDEN_SOURCES below is the stronger check.
FORBIDDEN_STRINGS='xbyak|oaknut|Dynarmic::|dynarmic::|JitShader|ARM_Dynarmic'
# Checked against the dSYM: no ARM JIT, no shader JIT, no OpenGL renderer.
FORBIDDEN_SOURCES='core/arm/dynarmic/[^ ]*\.cpp|externals/(dynarmic|oaknut|xbyak)/|shader/shader_jit[^ ]*\.cpp|renderer_opengl/[^ ]*\.cpp|externals/glad/'
# The network API is renamed to refusing stand-ins (flags.h), so none of it may be linked. _dlsym is allowed
# for compiler-rt's @available check.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_gethostbyname$|_dlopen$|_mprotect$|_vm_protect$|_mach_vm_remap$|_sys_icache_invalidate$|_sys_dcache_flush$|_pthread_jit'
