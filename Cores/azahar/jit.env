# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh azahar sources this after core.env
# and writes build/cores-jit/AzaharCore.xcframework; build/cores is untouched. The DevJIT configuration alone embeds
# it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else. Shell syntax.
#
# The ARM11 runs on Dynarmic's A32 front end and arm64 back end with oaknut, from upstream's own submodules at the
# commits 2126.2 records (externals/dynarmic, externals/oaknut, and Dynarmic's externals/mcl). generate.py --jit
# lists them (jit-sources.txt, jit-cmake.env). Code memory is a Cores/shared/Jit26.c region:
# jit/oaknut/code_block.hpp stands in for oaknut's, and jit/patch.py's copy of Dynarmic's address_space.cpp gives
# oaknut the RW alias to write through while every address, link and relocation stays the RX one. No fastmem, no
# exception handler (Dynarmic's generic one), never x18. The PICA200 shader JIT stays out: shader interpreter.
# citra_use_cpu_jit becomes "enabled" only when the probe ran; a later missing region falls back or stops (patch.py).

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/azahar"
# build-core.sh checks these at the commits upstream records: git -C Cores/azahar/upstream submodule update --init
# externals/dynarmic externals/oaknut, then git -C Cores/azahar/upstream/externals/dynarmic submodule update --init
# externals/mcl (core_jit_prepare checks that one).
CORE_UPSTREAM_SUBMODULES="$CORE_UPSTREAM_SUBMODULES externals/dynarmic externals/oaknut"
# shellcheck source=/dev/null
source "$root/Cores/azahar/jit-cmake.env"
jit_flags="-DGAGA_CORE_JIT -DGAGA_JIT_OPTION_KEY=\"citra_use_cpu_jit\" -DGAGA_JIT_OPTION_VALUE=\"enabled\""
jit_flags="$jit_flags -Ijit $jit_cmake_flags"
CORE_CFLAGS="$jit_flags $CORE_CFLAGS"
CORE_CXXFLAGS="$jit_flags $CORE_CXXFLAGS"

# Dynarmic and oaknut are the point of this build. The shader JIT, xbyak, the other back ends, the OpenGL renderer,
# Dynarmic's mach exception handler and oaknut's own code block (RX flipped with mprotect) stay out.
FORBIDDEN_STRINGS='xbyak|JitShader|asmjit::|JitRuntime|vixl::|GNU lightning'
FORBIDDEN_SOURCES='shader/shader_jit[^ ]*\.cpp|renderer_opengl/[^ ]*\.cpp|externals/glad/|externals/xbyak/|backend/(x64|riscv64)/|exception_handler_(macos|posix)'
# _mmap: only oaknut's own code block maps memory (RX, then mprotect flips), so none means jit/oaknut won.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_listen$|_accept$|_getaddrinfo$|_gethostbyname$|_dlopen$|_mmap$|_mprotect$|_mach_vm_remap$|_sys_dcache_flush$|_pthread_jit'
# Jit26.c: vm_remap and vm_protect make the RW alias; sys_icache_invalidate runs its probe and the code block's flush.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
SOURCE_AUDIT_REVIEWED='^(\.\./shared/Jit26\.c):'
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt and the copies. Run from Cores/azahar.
core_jit_prepare() {
    local list="$jit_out/sources.txt" copies="$jit_out/copies" a64=upstream/externals/dynarmic/src/dynarmic/backend/arm64
    mkdir -p "$jit_out"
    if ! git -C upstream/externals/dynarmic submodule status externals/mcl 2>/dev/null | grep -q '^ '; then
        echo "jit.env: run git -C Cores/azahar/upstream/externals/dynarmic submodule update --init externals/mcl" >&2
        return 1
    fi
    python3 -I jit/patch.py upstream "$copies"
    # Apple reserves x18. Dynarmic's allocator order leaves it out and no emitter names it; a new pin must too.
    grep -qF 'GPR_ORDER{19, 20, 21, 22, 23, 9, 10, 11, 12, 13, 14, 15, 0, 1, 2, 3, 4, 5, 6, 7, 8}' "$a64/abi.h" &&
        ! grep -rqwE '[XW]18' "$a64" || { echo "jit.env: Dynarmic's arm64 register use changed; review x18" >&2; return 1; }
    # jit-sources.txt lines replace sources.txt's lines for the same file; its new files follow. Upstream files with a
    # copy compile the copy, with their own folder for quoted includes. oaknut's include path gets jit/ in front.
    awk -v copies="$copies" '
        NR == FNR { jit[$1] = $0; order[++n] = $1; next }
        { line = ($1 in jit) ? jit[$1] : $0; used[$1] = 1
          if ($1 == "../shared/LibretroAdapter.c") line = "../shared/LibretroAdapterJit26.c"
          print line }
        END { for (i = 1; i <= n; ++i) if (!(order[i] in used)) print jit[order[i]]
              print "../shared/Jit26.c" }
    ' jit-sources.txt sources.txt |
        awk -v copies="$copies" '{
            n = split($1, part, "/"); dir = substr($1, 1, length($1) - length(part[n]) - 1)
            if ($1 ~ /(backend\/arm64\/address_space|core\/arm\/dynarmic\/arm_dynarmic|src\/core\/core|video_core\/shader\/shader)\.cpp$/) {
                $1 = copies "/" part[n] " -iquote " dir
            }
            print }' |
        sed 's| -Iupstream/externals/oaknut/include| -Ijit&|g' >"$list"
    [ "$(grep -c "^$copies/" "$list")" = 4 ] || { echo "jit.env: expected four copies in $list" >&2; return 1; }
    [ "$(grep -c 'LibretroAdapterJit26' "$list")" = 1 ] || { echo "jit.env: sources.txt has no ../shared/LibretroAdapter.c" >&2; return 1; }
}
