# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=SwanStationCore
CORE_EXPORT=_SwanStation_GetInterface
CORE_VERSION=1.0.0

# Source of truth: https://github.com/libretro/swanstation, the libretro fork of DuckStation from before its
# licence change, GPL-3.0 (upstream/LICENSE). No release tags, so this pins the master commit of 2026-10-24.
UPSTREAM_TAG=
UPSTREAM_COMMIT=631f0fb31b809e0f889d7c551fe695788e39c1d3

# upstream/Makefile.libretro is not run. sources.txt is its list for make -n platform=osx arch=arm64
# CPU_ARCH=none WITH_RECOMPILER=0 WITH_MMAP_FASTMEM=0: no recompiler, no vixl, no fastmem. Every recompiler
# and fastmem path in core/ sits under #ifdef WITH_RECOMPILER, which this build never defines, so
# common/jit_code_buffer.cpp and common/page_fault_handler.cpp are left out. gen/ holds the config.h and version.h the Makefile writes into the tree.
core_defines='-DNDEBUG -D__LIBRETRO__ -D_FILE_OFFSET_BITS=64 -DHAVE_MMAP -DRETRO_ATOMIC_FORCE_GCC_NEW -DGIT_VERSION="631f0fb3" -DGIT_HASH="631f0fb3"'
core_includes='-I../shared -Igen -Iupstream/src'
for swanstation_dir in glad/include libchdr/deps/lzma-25.01/include libchdr/deps/miniz-3.1.1 libchdr/deps/zstd-1.5.7 libchdr/include libretro-common/include openbios stb/include vulkan-loader/include xxhash/include; do
    core_includes="$core_includes -Iupstream/dep/$swanstation_dir"
done
# no_exec.h renames the loader, mprotect and shared memory calls (see that file).
CORE_CFLAGS="-std=gnu11 -O3 $core_defines -include no_exec.h $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=gnu++17 -O3 -fvisibility-inlines-hidden $core_defines -include no_exec.h $core_includes -Wno-everything"

# Reviewed hits of the source audit. MemoryArena's view mapping (258) and SetPageProtection (349) add PROT_EXEC
# only when asked; every caller, all in core/bus.cpp, passes executable=false. libretro-common memmap.c: a
# PROT_EXEC fallback define (39, 40), Windows-only protection maps (59, 72, 85), ARM32-only cache flushes (193,
# 196, 200), and memprotect (226), which nothing calls. no_exec.h's mprotect stub refuses PROT_EXEC.
SOURCE_AUDIT_REVIEWED='^upstream/src/common/memory_arena\.cpp:(258|349):|^upstream/dep/libretro-common/memmap/memmap\.c:(39|40|59|72|85|193|196|200|226):'

# The recompilers' and fastmem's source files. Their names must not reach the binary's debug info.
# File names only: settings fields such as cpu_recompiler_icache stay in every build.
FORBIDDEN_SOURCES='cpu_recompiler_[a-z0-9_]*\.(cpp|h)|jit_code_buffer\.(cpp|h)|page_fault_handler\.(cpp|h)|vixl'
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec|JitCodeBuffer'

# This build is offline and never loads code. A new import of these means a flag went wrong. Threads stay
# allowed: upstream's audio and CD code links them, though the options in SwanStationCore.c keep them off.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_shm_open$'
