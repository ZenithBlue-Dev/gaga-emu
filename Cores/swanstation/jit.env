# Sideload JIT build only (docs/04 section 8.1). GAGA_JIT=1 scripts/build-core.sh swanstation sources this after
# core.env and writes build/cores-jit/SwanStationCore.xcframework; build/cores is untouched. The DevJIT configuration
# alone embeds it (scripts/devjit-cores.sh), and scripts/nojit-gate.sh refuses it anywhere else. Shell syntax.
#
# Upstream's AArch64 recompiler (vixl), as its Makefile builds it for CPU_ARCH=aarch64 but without fastmem, on memory
# from Cores/shared/Jit26.c. JitCodeBufferJit26.cpp replaces jit_code_buffer.cpp: RX addresses everywhere, its own
# writes through the RW alias. A build-time copy of cpu_recompiler_code_generator_aarch64.cpp points vixl's five
# buffers (block emitters and backpatches) at the RW alias, so branch offsets stay computed from the RX address.
# swanstation_CPU_ExecutionMode becomes Recompiler only when that memory runs; fastmem stays Disabled.

# $root is scripts/build-core.sh's or scripts/nojit-gate.sh's repository root.
jit_out="$root/build/cores-jit/swanstation"
jit_flags="-DGAGA_CORE_JIT -DGAGA_JIT_OPTION_KEY=\"swanstation_CPU_ExecutionMode\" -DGAGA_JIT_OPTION_VALUE=\"Recompiler\""
jit_flags="$jit_flags -DWITH_RECOMPILER=1 -DVIXL_INCLUDE_TARGET_A64 -DVIXL_CODE_BUFFER_MALLOC"
jit_flags="$jit_flags -Iupstream/dep/vixl/include -Iupstream/dep/vixl/include/vixl -Iupstream/dep/vixl/include/vixl/aarch64"
CORE_CFLAGS="$jit_flags $CORE_CFLAGS"
CORE_CXXFLAGS="$jit_flags $CORE_CXXFLAGS"

# The other back ends and xbyak stay out, and so does upstream's MAP_JIT code buffer.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|GNU lightning|jit_compile'
FORBIDDEN_SOURCES='cpu_recompiler_code_generator_(x64|aarch32)\.cpp|src/common/jit_code_buffer\.cpp|xbyak|vixl/src/aarch32'
# _mprotect stays allowed as in core.env: only SwanStationCore.c's stub calls it, and it refuses PROT_EXEC.
FORBIDDEN_IMPORTS="$FORBIDDEN_IMPORTS|_pthread_jit"
# Jit26.c: vm_remap and vm_protect make the RW alias; sys_icache_invalidate runs its probe and the buffer's flush.
ALLOWED_IMPORTS='(^|[[:space:]])_(vm_remap|vm_protect|sys_icache_invalidate)$'
# The recompiler's code-generation calls are the reviewed purpose of this build; core.env's reviews still hold.
SOURCE_AUDIT_REVIEWED="$SOURCE_AUDIT_REVIEWED|^(\.\./shared/Jit26\.c|JitCodeBufferJit26\.cpp|upstream/src/common/page_fault_handler\.cpp|upstream/src/core/cpu_recompiler_[a-z0-9_]+\.cpp|upstream/dep/vixl/src/[a-z0-9/_-]+\.cc|$jit_out/cpu_recompiler_code_generator_aarch64\.cpp):"
CORE_JIT_MARKER='GAGA_DEV_JIT_OPTION_MARKER'

# Writes $jit_out/sources.txt and the code generator copy. Run from Cores/swanstation.
core_jit_prepare() {
    local name rest list="$jit_out/sources.txt" gen="$jit_out/cpu_recompiler_code_generator_aarch64.cpp"
    mkdir -p "$jit_out"
    sed 's/static_cast<vixl::byte\*>(\([^,]*\)),/static_cast<vixl::byte*>(gaga_jit26_writable(\1)),/' \
        upstream/src/core/cpu_recompiler_code_generator_aarch64.cpp >"$gen"
    [ "$(grep -c 'gaga_jit26_writable' "$gen")" = 5 ] || { echo "jit.env: upstream's AArch64 code generator changed; review the copy" >&2; return 1; }
    while read -r name rest; do
        [ "$name" != ../shared/LibretroAdapter.c ] || name=../shared/LibretroAdapterJit26.c
        echo "$name${rest:+ $rest}"
    done <sources.txt >"$list"
    { echo ../shared/Jit26.c
      echo JitCodeBufferJit26.cpp
      echo upstream/src/common/page_fault_handler.cpp
      for name in cpu_recompiler_code_generator cpu_recompiler_code_generator_generic cpu_recompiler_register_cache; do
          echo "upstream/src/core/$name.cpp"
      done
      # Same-directory includes resolve against upstream's folder, not the copy's.
      echo "$gen -iquote upstream/src/core -include Jit26.h"
      for name in code-buffer-vixl compiler-intrinsics-vixl cpu-features utils-vixl; do echo "upstream/dep/vixl/src/$name.cc"; done
      for name in assembler cpu cpu-features-auditor decoder disasm instructions instrument logic macro-assembler operands \
          pointer-auth simulator; do
          echo "upstream/dep/vixl/src/aarch64/$name-aarch64.cc"
      done
    } >>"$list"
}
