# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=NestopiaCore
CORE_EXPORT=_Nestopia_GetInterface
CORE_VERSION=2.0.0

# Source of truth: https://github.com/libretro/nestopia, the URL libretro-super builds from (Nestopia UE).
# GPL-2.0-or-later. The repository has no release tags, so this pins the master commit of 2026-10-31.
# CORE_VERSION is NST_VERSION in upstream/libretro/libretro.cpp.
UPSTREAM_TAG=
UPSTREAM_COMMIT=f1e02d12664834536edbf7352995a3d0cd1caef4

# upstream/libretro/Makefile is not run. These match its DEFINES and its GCC flags (C++98, no RTTI).
# NST_NO_ZLIB is upstream's own: states are never compressed, and no zlib is linked.
core_defines='-DNDEBUG -D__LIBRETRO__ -DNST_NO_ZLIB'
core_includes='-I../shared -Iupstream/libretro -Iupstream -Iupstream/source -Iupstream/libretro/libretro-common/include'
CORE_CFLAGS="-std=gnu99 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="-std=c++98 -fno-rtti -O2 $core_defines $core_includes -Wno-everything"

# From the source audit in docs/03 section 5. Nestopia is an interpreter with no recompiler. Bare "jit" is
# not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# This build is single threaded, offline and never loads code. A new import of these means a flag went wrong.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_dlopen$|_dlsym$|_pthread_create$|_mprotect$'
