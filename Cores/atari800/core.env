# Read by scripts/build-core.sh and scripts/nojit-gate.sh. Shell syntax.
CORE_FRAMEWORK=Atari800Core
CORE_EXPORT=_Atari800_GetInterface
CORE_VERSION=7.0.0

# Source of truth: https://github.com/libretro/libretro-atari800, libretro's port of Atari800. GPL-2.0-or-later,
# with the AltirraOS replacement ROMs (all-permissive), zlib (Zlib) and libretro-common (MIT). Upstream has no
# tags, so this pins the master commit of 2026-09-01.
UPSTREAM_TAG=
UPSTREAM_COMMIT=4e7fbc73765c1a9670c7506616046ad1d4ccda51

# upstream/Makefile is not run. These match its iOS target (DEFINES plus -DIOS -DHAVE_POSIX_MEMALIGN) and
# Makefile.common's includes, with the bundled zlib. -Dfdopen=fdopen stops zlib's zutil.h from redefining fdopen
# as NULL on Apple targets (its TARGET_OS_MAC branch), which breaks <stdio.h>.
core_defines='-DNDEBUG -D__LIBRETRO__ -DINLINE=inline -DHAVE_CONFIG_H -DIOS -DHAVE_POSIX_MEMALIGN -Dfdopen=fdopen'
core_includes='-I../shared -Iupstream -Iupstream/atari800/src -Iupstream/libretro -Iupstream/libretro/libretro-common/include -Iupstream/libretro/libretro-common/include/compat/zlib -Iupstream/deps/zlib'
CORE_CFLAGS="-std=gnu11 -O2 $core_defines $core_includes -Wno-everything -Werror=implicit-function-declaration"
CORE_CXXFLAGS="$CORE_CFLAGS"

# A 6502 interpreter. Bare "jit" is not used: machine-code bytes can match it.
FORBIDDEN_STRINGS='asmjit::|JitRuntime|xbyak|dynarmic|oaknut|vixl::|GNU lightning|jit_compile|dynarec'

# Offline and never loads code. The R: device (atari800_rdevice) would need sockets; none are allowed.
FORBIDDEN_IMPORTS='_socket$|_connect$|_bind$|_getaddrinfo$|_dlopen$|_dlsym$|_mprotect$|_pthread_create$'
