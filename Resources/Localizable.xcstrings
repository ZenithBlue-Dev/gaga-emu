    "You have GagaEmu Pro" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Tienes GagaEmu Pro" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Vous avez GagaEmu Pro" } } } },
    "Forever: nothing more to pay." : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Para siempre: nada más que pagar." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Pour toujours : plus rien à payer." } } } },
    "Monthly and Yearly renew automatically unless cancelled at least 24 hours before the end of the current period. Payment is charged to your Apple Account when you confirm. Any unused free trial ends when you subscribe. Manage or cancel in Settings > Apple Account > Subscriptions. Forever is one payment." : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Mensual y Anual se renuevan automáticamente salvo que se cancelen al menos 24 horas antes del final del periodo actual. El pago se carga a tu Cuenta de Apple al confirmar. Cualquier prueba gratuita no usada termina al suscribirte. Gestiona o cancela en Ajustes > Cuenta de Apple > Suscripciones. Para siempre es un único pago." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Mensuel et Annuel se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période en cours. Le paiement est débité de votre compte Apple à la confirmation. Tout essai gratuit non utilisé prend fin lors de l'abonnement. Gérez ou annulez dans Réglages > Compte Apple > Abonnements. Pour toujours est un paiement unique." } } } },
    "Buy Forever" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Comprar Para siempre" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Acheter Pour toujours" } } } },
    "Start %@ Free" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Empezar %@ gratis" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Commencer %@ gratuit" } } } },
    "Subscribe" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Suscribirse" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "S'abonner" } } } },
    "Working…" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Procesando…" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "En cours…" } } } },
    "Restore Purchases" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Restaurar compras" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Restaurer les achats" } } } },
    "Manage Subscription" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Gestionar suscripción" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Gérer l'abonnement" } } } },
    "Redeem Offer" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Canjear oferta" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Utiliser une offre" } } } },
    "Terms of Use" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Condiciones de uso" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Conditions d'utilisation" } } } },
    "Best value" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Mejor precio" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Meilleur prix" } } } },
    "one payment" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "un único pago" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "paiement unique" } } } },
    "One payment" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Un único pago" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Paiement unique" } } } },
    "%@ free" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ gratis" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "%@ gratuit" } } } },
    "Free Trial" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Prueba gratuita" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Essai gratuit" } } } },
    "Introductory Offer" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Oferta de introducción" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Offre de lancement" } } } },
    "Monthly" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Mensual" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Mensuel" } } } },
    "Yearly" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Anual" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Annuel" } } } },
    "Forever" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Para siempre" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Pour toujours" } } } },
    "Active" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Activa" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Actif" } } } },
    "Not subscribed" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Sin suscripción" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Non abonné" } } } },
    "Version" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Versión" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Version" } } } },
    "WebDAV Server" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Servidor WebDAV" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Serveur WebDAV" } } } },
    "JIT" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "JIT" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "JIT" } } } },
    "Not available in this version" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No disponible en esta versión" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Indisponible dans cette version" } } } },
    "Available, debugger attached" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Disponible, depurador conectado" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Disponible, débogueur attaché" } } } },
    "Not enabled. Open GagaEmu with StikDebug." : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "No activado. Abre GagaEmu con StikDebug." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Non activé. Ouvrez GagaEmu avec StikDebug." } } } },
    "JIT (just-in-time compilation) makes some systems run much faster. Apple does not allow it in App Store apps, so this version runs every core as an interpreter. The sideload build can use JIT on the cores below when a debugger such as StikDebug enables it." : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "El JIT (compilación en tiempo de ejecución) hace que algunos sistemas funcionen mucho más rápido. Apple no lo permite en las apps del App Store, así que esta versión ejecuta todos los núcleos como intérprete. La versión de instalación lateral puede usar JIT en los núcleos de abajo cuando un depurador como StikDebug lo activa." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Le JIT (compilation à la volée) rend certains systèmes beaucoup plus rapides. Apple ne l'autorise pas dans les apps de l'App Store, donc cette version exécute chaque cœur comme interpréteur. La version en sideload peut utiliser le JIT sur les cœurs ci-dessous quand un débogueur comme StikDebug l'active." } } } },
    "Cores with JIT in the sideload build" : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Núcleos con JIT en la versión de instalación lateral" } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Cœurs avec JIT dans la version en sideload" } } } },
    "A sideload build with JIT is available." : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "Hay disponible una versión de instalación lateral con JIT." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "Une version en sideload avec JIT est disponible." } } } }
  },
  "version" : "1.0"
}
