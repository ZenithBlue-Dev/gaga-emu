    "In a game: Pause, then Cheats. Or a game's page in the Library." : { "localizations" : { "es" : { "stringUnit" : { "state" : "needs_review", "value" : "En un juego: Pausa y luego Trucos. O la página del juego en la Biblioteca." } }, "fr" : { "stringUnit" : { "state" : "needs_review", "value" : "En jeu : Pause, puis Codes de triche. Ou la page du jeu dans la Bibliothèque." } } } },
