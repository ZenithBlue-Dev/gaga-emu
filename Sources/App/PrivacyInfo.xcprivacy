<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- No tracking, analytics or crash upload. One item leaves the device, and only with the Cover Art
         toggle on (off by default): game titles, in HTTPS request URLs to thumbnails.libretro.com
         (CoverArtFetcher, an ephemeral session with no cookies), a third party whose server logs the app
         cannot control. Hence declared, not linked to identity, for app function. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
    <!-- Required-reason APIs, from `nm -u` on the app and every core framework (docs/06 section 3, step 11).
         One manifest covers every GAGA_CORE_SET, so it declares what any core imports. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- AppState and ControllerManager keep settings in the app's own standard UserDefaults. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- SaveStore reads save state modification dates to list them, LibraryView reads a game file's
             size with attributesOfItem, and the cores import stat, fstat or lstat for their own ROM, disc,
             save and memory card files: MgbaCore, GambatteCore, PcsxReArmedCore, BsnesCore, MelonDSCore,
             JgenesisCore, DosboxPureCore, MameCore and BeetleSaturnCore. All of these files are inside the app
             container. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <!-- MameCore imports statfs and fstatfs, from the SQLite in MAME's Lua layer, which reads the volume
             of a database file it is about to write (its flags and sector size), on the device. No Lua script
             or plugin runs (docs/03 section 5), and nothing leaves the device. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
        <!-- VkTestCore, and every layer-path core after it, links MoltenVK, which imports mach_absolute_time
             to time GPU work inside the app. BeetleSaturnCore imports it through libretro-common's rtime and
             features_cpu, for elapsed-time counters inside the app. No boot time leaves the device. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
